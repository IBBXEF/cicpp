{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CI/CPP",
  "scopeName": "source.cicpp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#keywords" },
    { "include": "#storage-types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cicpp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cicpp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "keyword.control.directive.include.cicpp",
          "match": "#\\s*(include_C|include)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cicpp",
          "match": "\\b(if|elif|else|while|return|match|with)\\b"
        },
        {
          "name": "keyword.other.cicpp",
          "match": "\\b(type|fun|specialize|as|const|static|typeof)\\b"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.cicpp",
          "match": "\\b(void|int|char|bool)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.cicpp",
          "match": "\\b(nullptr|true|false)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfunc\\s+([a-zA-Z_][a-zA-Z0-9_*]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "storage.type.cicpp" },
            "2": { "name": "entity.name.function.cicpp" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "name": "support.function.cicpp"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\btype\\s+<([^>]+)>\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.parameter.cicpp" },
            "2": { "name": "entity.name.type.cicpp" }
          }
        },
        {
          "match": "\\btype\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.cicpp" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cicpp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cicpp",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.cicpp",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.cicpp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cicpp",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cicpp",
          "match": "(=|==|!=|<=|>=|<|>|\\+|\\-|\\*|/|&|->|\\.)"
        }
      ]
    }
  }
}