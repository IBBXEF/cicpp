
// #include "src/cicpp/clist.cicpp"
#include "src/cicpp/lexer.cicpp"



type nonterm_symb {
    Rval;
    Rval1;
    Rvalop;
    RvalI;
    Lval;
}

type gram_rule_t {

    specialize clist<gram_rule_t*> as gram_rules

    type gram_symbol_t {
        Term { token tok; };
        Exact { token tok; };
        NonTerm { nonterm_symb symb; };

        func bool match_ok(toklist* l, int max_depth, gram_rules rules) {
            return match_symb(l, max_depth, rules) != nullptr; // this will cause a memory leak but works
        }
        func void* match_symb(toklist* l, int max_depth, gram_rules rules) {
            if kind == Term {
                if (((*l).ith(0)).kind) != (((dat.Term_dat).tok).kind) {
                    return nullptr;
                }
                *l = (*l).tail();
                return ((*l).ith_ref(0)) as void* ;
            } elif kind == Exact {
                if ((*l).ith(0)).eq((dat.Exact_dat).tok) {
                    return nullptr;
                }
                *l = (*l).tail();
                return ((*l).ith_ref(0)) as void* ;
            } else { // kind == NonTerm
                if max_depth < 0 {
                    return nullptr;
                }
                int i;
                i = 0;
                toklist base;
                base = *l;
                while i < (rules.len()) {
                    gram_rule_t rule;
                    rule = *(rules.ith(i));
                    if ((((rule).result).kind) == (((dat.NonTerm_dat).symb).kind)) {
                        *l = base;
                        if rule.parse_ok(l, max_depth, rules) {
                            return rule.parse(l, max_depth, rules);
                        }
                    }
                    i = i + 1;
                }
                return nullptr;
            }
        }
        
        func void set_Term() { // temporary
            kind = Term;
        }
        func void set_NonTerm() { // temporary
            kind = NonTerm;
        }
        func void set_Exact() { // temporary
            kind = Exact;
        }
    }

    specialize clist<gram_symbol_t> as symlist

    symlist pattern; // a nonempty list of symbols
    nonterm_symb result;

    // user-defined "result function" that will turn the matched pattern into the result.
    clist_voidptr -> void* result_function;


    func bool parse_ok(toklist* l, int max_depth, gram_rules rules) {
        return ((*this).parse(l, max_depth, rules)) != nullptr; // this will cause a memory leak but works
    }

    func void* parse(toklist* l, int max_depth, gram_rules rules) {
        int i;
        i = 0;
        clist_voidptr vlues;
        vlues.init();
        while (i < pattern.len()) {
            gram_symbol_t sym;
            sym = pattern.ith(i);
            if (!sym.match_ok(l, max_depth-1, rules)) {
                return nullptr;
            }
            void* vals;
            vals = sym.match_symb(l, max_depth-1, rules);
            vlues.push(vals);
        }
        vlues.reverse();
        void* ret;
        ret = result_function(vlues);
        vlues.del();
        return ret;
    }

    func void init(nonterm_symb rule_result, clist_voidptr -> void* rule_result_function) {
        result = rule_result;
        result_function = rule_result_function;
        pattern.init();
    }

    func void add_nonterm(nonterm_symb nt) {
        gram_symbol_t sym;
        sym.set_NonTerm();
        ((sym.dat).NonTerm_dat).symb = nt;
        pattern.append(sym);
    }

    func void add_term(const char* str) {
        toklist l;
        l = lex_string(str);
        while (l.len()) {
            gram_symbol_t sym;
            sym.set_Term();
            ((sym.dat).Term_dat).tok = l.pop();
            pattern.append(sym);
        }
    }

    func void add_exact(const char* str) {
        toklist l;
        l = lex_string(str);
        while (l.len()) {
            gram_symbol_t sym;
            sym.set_Exact();
            ((sym.dat).Exact_dat).tok = l.pop();
            pattern.append(sym);
        }
    }
}

specialize clist<gram_rule_t> as gram_rules



