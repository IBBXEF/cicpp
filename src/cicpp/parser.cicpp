
#include "src/cicpp/clist.cicpp"
#include "src/cicpp/anyptr.cicpp"
#include "src/cicpp/set.cicpp"
#include "src/cicpp/lexer.cicpp"
#include_C "limits.h"
#include_C "stdio.h"
#include_C "string.h"


// if the string is in the list, the pointer is freed and the index returned. otherwise, it is added to the list and its idex is returned
func int string_list_thingy(string_list* l, char* str) {
    int i;
    i = string_list_find(*l, str);
    if i < 0 {
        (*l).append(str);
        return (l->len()) - 1;
    }
    free(str);
    return i;
}
func char* copy_string_until_char(const char** str, char c) {
    const char* base;
    base = *str;
    while (((*(*str)) && ((*(*str)) != c))) {
        *str = (*str) + 1;
    }
    int len;
    len = (*str) - base;
    char* ret;
    ret = (malloc(len + 1)) as char* ;
    ret[len] = '\0';
    int i;
    i = 0;
    while i < len {
        ret[i] = base[i];
        i = i + 1;
    }
    return ret;
}

type gram_rule_t {

    specialize clist<gram_rule_t*> as gram_rules

    type gram_symbol_t {
        Term { token tok; };
        Exact { token tok; };
        NonTerm { int symb; };

        func void set_nonterm(int i) {
            kind = NonTerm;
            (dat.NonTerm_dat).symb = i;
        }
        func void set_term(token t) {
            kind = Term;
            (dat.Term_dat).tok = t;
        }
        func void set_exact(token t) {
            kind = Exact;
            (dat.Term_dat).tok = t;
        }
        func bool match_tok(token t) {
            if kind == Exact {
                return t.eq((dat.Exact_dat).tok);
            } elif kind == Term {
                return (((dat.Exact_dat).tok).kind) == (t.kind);
            } else {
                return false;
            }
        }
        func bool includes(gram_symbol_t s) {
            if (kind == NonTerm) || ((s.kind) == NonTerm) {
                printf("invalid inclusion test of gram_symbol_t\n");
                exit(EXIT_FAILURE);
            }
            if ((s.kind) == Exact) || (kind == Term) {
                return match_tok(((s.dat).Exact_dat).tok);
            }
            return false;
        }
        func bool eq(gram_symbol_t b) {
            if kind != (b.kind) {
                return false;
            }
            if kind == NonTerm { // NonTerm
                return ((dat.NonTerm_dat).symb) == (((b.dat).NonTerm_dat).symb);
            } elif kind == Exact {
                return ((dat.Exact_dat).tok).eq(((b.dat).Exact_dat).tok);
            } else {
                return (((dat.Term_dat).tok).kind) == ((((b.dat).Term_dat).tok).kind);
            }
        }

        func void print(string_list nonterm_symbs) {
            if kind == Term {
                printf("Term (id %d)", ((((dat.Term_dat).tok).kind) as int));
            } elif kind == Exact {
                printf("Exact (id %d)", ((((dat.Term_dat).tok).kind) as int));
            } else {
                printf("$%s",
                    ( nonterm_symbs.ith((dat.NonTerm_dat).symb)) );
            }
        }
    }
    
    specialize clist<gram_symbol_t> as symlist

    type parsing_table {
        type sym_rule_pair { gram_symbol_t s; gram_rule_t* r; }
        specialize clist<sym_rule_pair> as pairlist
        pairlist* tables;
        int _n_nonterms;
        func void init_empty(int n_nonterms) {
            tables = malloc(sizeof(pairlist)*n_nonterms) as pairlist*;
            int i;
            i = 0;
            while i < n_nonterms {
                tables[i].init();
                i = i + 1;
            }
            _n_nonterms = n_nonterms;
        }
        func void add_entry(gram_symbol_t s, int nonterm, gram_rule_t* r) {
            if ((s.kind) as int) == 2 { // 2 = Nonterminal
                printf("invalid gram symbol for rule table: it is Nonterminal\n");
                exit(EXIT_FAILURE);
            }
            if ((nonterm < 0) || (nonterm >= _n_nonterms)) {
                printf("invalid nonterminal index %d in parsing table\n", nonterm);
                exit(EXIT_FAILURE);
            }
            int i;
            i = 0;
            pairlist table;
            table = tables[nonterm];
            while i < (table.len()) {
                gram_symbol_t s2;
                s2 = (table.ith(i)).s;
                if ((s2.includes(s)) || (s.includes(s2))) {
                    if !(r->eq(*(table.ith(i)).r)) { // there is a real conflict
                        string_list empty;
                        empty.init();
                        printf("conflicting entry in the parsing table for nonterm %d and symbol ", nonterm);
                        s.print(empty);
                        printf("\n");
                        exit(EXIT_FAILURE);
                    }
                }
                i = i + 1;
            }
            sym_rule_pair pair;
            pair.s = s;
            pair.r = r;
            tables[nonterm].push(pair);
        }
        func gram_rule_t* lookup(token t, int nonterm) {
            if ((nonterm < 0) || (nonterm >= _n_nonterms)) {
                printf("invalid nonterminal index %d in parsing table\n", nonterm);
                exit(EXIT_FAILURE);
            }
            int i;
            i = 0;
            pairlist tab;
            tab = tables[nonterm];
            while i < (tab.len()) {
                if ((tab.ith(i)).s).match_tok(t) {
                    return (tab.ith(i)).r;
                }
                i = i + 1;
            }
            return nullptr;
        }
        func void del() {
            int i;
            i = 0;
            while i < _n_nonterms {
                tables[i].del(); // the list's elements don't allocate memory
                i = i + 1;
            }
        }
    }


    symlist pattern; // a nonempty list of symbols
    int result;

    // user-defined "result function" that will turn the matched pattern into the result.
    // the input pointers's ownership belongs to the function, but not the list itself
    clist_anyptr -> anyptr result_function;
    void* func_bonus_dat; // optionnal additionnal data that will be given to the function as the last element of the clist.

    type parsed_ast {
        Leaf { token t; };
        Node { clist_voidptr childrens; gram_rule_t* origin_rule; };
        Unknown;

        func void init_unknown() {
            kind = Unknown;
        }
        func void init_node(gram_rule_t* origin_rule) {
            kind = Node;
            (dat.Node_dat).origin_rule = origin_rule;
            ((dat.Node_dat).childrens).init();
        }
        func void init_leaf(token t) {
            kind = Leaf;
            (dat.Leaf_dat).t = t;
        }
        func void push_child(parsed_ast* child) {
            ((dat.Node_dat).childrens).push(child);
        }
        func void append_child(parsed_ast* child) {
            ((dat.Node_dat).childrens).append(child);
        }

        func anyptr evaluate_ast() {
            anyptr ret;
            if kind == Leaf {
                ret.init_view(&((dat.Leaf_dat).t));
                return ret;
            } elif kind == Node { // Node
                clist_anyptr args;
                args.init();
                int i;
                i = 0;
                clist_voidptr kids;
                kids = (dat.Node_dat).childrens;
                while i < kids.len() {
                    parsed_ast* child;
                    child = (kids.ith(i)) as parsed_ast*;
                    args.append(child->evaluate_ast());
                    i = i + 1;
                }
                anyptr tmp;
                tmp.init_view(((dat.Node_dat).origin_rule)->func_bonus_dat);
                args.append(tmp);
                anyptr res;
                res = (((dat.Node_dat).origin_rule)->result_function)(args);
                args.del();
                return res;
            } else { // Unknown
                printf("tried to evaluate unknown ast node\n");
                exit(EXIT_FAILURE);
            }
        }
    }

    type symbol_dat {

        specialize clist<symbol_dat*> as symdatptrlist

        parsed_ast* ast_loc;
        gram_symbol_t sym;

        func void update_tok_ast(token t) {
            ast_loc->init_leaf(t);
        }
        func void init(gram_symbol_t symb, parsed_ast* ast) {
            sym = symb;
            ast_loc = ast;
        }
    }

    specialize clist<symbol_dat> as symdatlist

    func void init(int rule_result, clist_anyptr -> anyptr rule_result_function) {
        result = rule_result;
        result_function = rule_result_function;
        func_bonus_dat = nullptr;
        pattern.init();
    }
    func void init_bonus_func_data(int rule_result, clist_anyptr -> anyptr rule_result_function, void* result_func_bonus_dat) {
        init(rule_result, rule_result_function);
        func_bonus_dat = result_func_bonus_dat;
    }
    func void del() {
        pattern.del(); // gram_symbol_t does not perform any allocations
    }
    func bool eq(gram_rule_t r) {
        printf("test: ");
        if result != (r.result) {
            printf("f3\n");
            return false;
        }
        if (pattern.len()) != ((r.pattern).len()) {
            printf("f4\n");
            return false;
        }
        int i;
        i = 0;
        while i < (pattern.len()) {
            gram_symbol_t s1;
            gram_symbol_t s2;
            s1 = pattern.ith(i);
            s2 = (r.pattern).ith(i);
            if !((s1.includes(s2)) && (s2.includes(s1))) {
                printf("f5\n");
                return false;
            }
            i = i + 1;
        }
        if result_function != (r.result_function) {
            printf("f1\n");
            return false;
        }
        if func_bonus_dat != (r.func_bonus_dat) {
            printf("f2\n");
            return false;
        }
        printf("f0\n");
        return true;
    }
    func void add_nonterm(int nt) {
        gram_symbol_t sym;
        sym.set_nonterm(nt);
        pattern.push(sym); // pattern is in reverse order
    }
    func void add_term(const char* str) {
        toklist l;
        l = lex_string(str);
        while (l.len()) {
            gram_symbol_t sym;
            sym.set_term(l.pop());
            pattern.push(sym); // pattern is in reverse order
        }
    }
    func void add_exact(const char* str) {
        toklist l;
        l = lex_string(str);
        while (l.len()) {
            gram_symbol_t sym;
            sym.set_exact(l.pop());
            pattern.push(sym); // pattern is in reverse order
        }
    }

    func void print(string_list nonterm_symbs) {
        printf("rule: $%s -> ", nonterm_symbs.ith(result));
        int i;
        i = 0;
        while i < (pattern.len()) {
            if i {
                printf(" ");
            }
            (pattern.ith((pattern.len()) - (i + 1))).print(nonterm_symbs); // pattern is in reverse order
            i = i + 1;
        }
        printf("\n");
    }

    specialize comparable_ptr<gram_symbol_t> as term_ptr
    specialize set<term_ptr> as term_set

    static func parsing_table make_parsing_table(gram_rules rules, string_list nonterm_symbs, int goal_nonterm, gram_symbol_t* stop_symbol) {
        // create an initialize Fi
        term_set* Fi;
        Fi = (malloc(sizeof(term_set)*(nonterm_symbs.len()))) as term_set*;
        term_set* FiRules;
        FiRules = (malloc(sizeof(term_set)*(rules.len()))) as term_set*;
        term_ptr tmp_ptr;
        term_ptr epsilon;
        tmp_ptr.init_null();
        epsilon.init_null();
        int i;
        i = 0;
        while i < (nonterm_symbs.len()) {
            Fi[i].init();
            i = i + 1;
        }
        i = 0;
        while i < (rules.len()) {
            FiRules[i].init();
            i = i + 1;
        }

        // populate Fi
        bool not_finished;
        not_finished = true;
        while not_finished {
            not_finished = false;
            i = 0;
            while i < (rules.len()) {
                gram_rule_t* rule;
                rule = rules.ith(i);
                term_set* cFi;
                cFi = Fi + rule->result; // current Fi

                term_set addFi;
                addFi.init();
                int j;
                j = ((rule->pattern).len())-1; // pattern is stored in reverse order
                while 0 <= j {
                    gram_symbol_t* sy;
                    sy = (rule->pattern).ith_ref(j);
                    if ((sy->kind) as int) != 2 { // terminal or exact
                        tmp_ptr.init_ptr(sy);
                        addFi.add(tmp_ptr);
                        j = -2; // we break the loop
                    } else { // nonterminal
                        term_set* oFi;
                        oFi = Fi + (((sy->dat).NonTerm_dat).symb); // other Fi
                        if oFi->contains(epsilon) {
                            tmp_ptr.init_null();
                            oFi->remove(epsilon);
                            addFi.union_with(*oFi);
                            oFi->add(epsilon);
                        } else {
                            addFi.union_with(*oFi);
                            j = -2; // we break out of the loop
                        }
                    }
                    j = j - 1;
                }
                if j == (-1) {
                    addFi.add(epsilon); // we add epsilon
                }
                FiRules[i].del();
                FiRules[i] = addFi;
                not_finished = (cFi->union_with(addFi)) || not_finished;
                i = i + 1;
            }
        }

        // create an initialize Fo
        term_set* Fo;
        Fo = (malloc(sizeof(term_set)*(nonterm_symbs.len()))) as term_set*;
        i = 0;
        while i < (nonterm_symbs.len()) {
            Fo[i].init();
            i = i + 1;
        }
        tmp_ptr.init_ptr(stop_symbol);
        Fo[goal_nonterm].add(tmp_ptr);

        // populate Fo
        not_finished = true;
        while not_finished {
            not_finished = false;
            i = 0;
            while i < (rules.len()) {
                gram_rule_t* rule;
                rule = rules.ith(i);
                term_set* cFo;
                cFo = Fo + rule->result; // current Fi

                term_set wFi;
                wFi.init();
                wFi.add(epsilon);
                int j;
                j = 0; // we iterate the pattern in reverse order
                while j < ((rule->pattern).len()) {
                    gram_symbol_t* sy;
                    sy = (rule->pattern).ith_ref(j);
                    if ((sy->kind) as int) != 2 { // terminal or exact
                        wFi.del();
                        wFi.init();
                        tmp_ptr.init_ptr(sy);
                        wFi.add(tmp_ptr);
                    } else { // nonterminal
                        term_set* oFo;
                        oFo = Fo + (((sy->dat).NonTerm_dat).symb); // other Fi
                        if wFi.contains(epsilon) {
                            not_finished = (oFo->union_with(*cFo)) || not_finished;
                        }
                        not_finished = (oFo->union_with(wFi)) || not_finished; // this may add epsilon to the set, but we'll clean it later

                        term_set* oFi;
                        oFi = Fi + (((sy->dat).NonTerm_dat).symb); // other Fi
                        if oFi->contains(epsilon) {
                            oFi->remove(epsilon);
                            wFi.union_with(*oFi);
                            oFi->add(epsilon);
                        } else {
                            wFi.del();
                            wFi.init();
                            wFi.union_with(*oFi);
                        }
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
        }

        parsing_table ret;
        ret.init_empty(nonterm_symbs.len());

        i = 0;
        while i < (nonterm_symbs.len()) {
            term_set cFo;
            cFo = Fo[i];
            cFo.remove(epsilon); // we remove the epsilons that we may have added before
            int j;
            j = 0;
            while j < (rules.len()) {
                if ((((rules).ith(j))->result) == i) {
                    term_set cFi;
                    cFi = FiRules[j];

                    term_set tmp;
                    tmp.init();

                    tmp.union_with(cFi);
                    tmp.remove(epsilon);

                    if cFi.contains(epsilon) {
                        tmp.union_with(cFo);
                    }

                    int k;
                    k = 0;
                    while k < (tmp.elts).len() {
                        gram_symbol_t* s;
                        s = ((tmp.elts).ith(k)).ptr;
                        ret.add_entry(*s, i, rules.ith(j));
                        k = k + 1;
                    }
                }
                j = j + 1;
            }
            cFo.del();
            Fi[i].del();
            i = i + 1;
        }
        i = 0;
        while i < (rules.len()) {
            FiRules[i].del();
            i = i + 1;
        }
        free(Fi);
        free(FiRules);
        free(Fo);
        return ret;
    }

    static func anyptr parse_with_rules(toklist* l, int goal_nonterm, gram_symbol_t stop_symbol, gram_rules rules, string_list nonterm_symbs) {
        if ((stop_symbol.kind) as int) == 2 { // 2 = Nonterminal
            printf("invalid stop symbol: it is Nonterminal\n");
            exit(EXIT_FAILURE);
        }
        symdatlist stack;
        parsed_ast ast;
        stack.init();
        ast.init_unknown();

        gram_symbol_t sym_tmp;
        sym_tmp.set_nonterm(goal_nonterm);
        symbol_dat sym_dat_tmp;
        sym_dat_tmp.init(sym_tmp, &ast);
        stack.push(sym_dat_tmp);

        token stop_token;
        if (((stop_symbol.kind) as int) == 1) { // Exact
            stop_token = ((stop_symbol.dat).Exact_dat).tok;
        } else {
            stop_token = ((stop_symbol.dat).Term_dat).tok;
        }

        parsing_table table;
        table = make_parsing_table(rules, nonterm_symbs, goal_nonterm, &stop_symbol); // we rebuild the table each time, it is wasteful but for now it's okay

        while (stack.len()) > 0 {
            symbol_dat stacktop;
            stacktop = stack.pop();
            token inptop;
            if (l->len()) && !(stop_symbol.match_tok(l->ith(0))) {
                inptop = l->ith(0);
            } else {
                inptop = stop_token;
            }

            if (((stacktop.sym).kind) as int) != 2 { // the top element of our stack is a token
                if !(stacktop.sym).match_tok(inptop) {
                    printf("failed to parse: got token id %d\n", (inptop.kind) as int);
                    exit(EXIT_FAILURE);
                }
                stacktop.update_tok_ast(inptop);
                *l = l->tail();
                printf("parse tok ok\n");
            } else { // the element at the top of our stack is a nonterminal
                int nt;
                nt = (((stacktop.sym).dat).NonTerm_dat).symb; // current nonterminal
                gram_rule_t* rule;
                rule = table.lookup(inptop, nt);
                if rule == nullptr {
                    printf("failed to parse: no rule found for nonterminal %s with token kind %d\n", (nonterm_symbs.ith(nt)), (inptop.kind) as int);
                    exit(EXIT_FAILURE);
                }
                
                parsed_ast* ast_loc;
                ast_loc = stacktop.ast_loc;

                ast_loc->init_node(rule);
                int i;
                i = 0;
                while i < ((rule->pattern).len()) {
                    parsed_ast* child_ast;
                    child_ast = (malloc(sizeof(parsed_ast))) as parsed_ast*;
                    child_ast->init_unknown();
                    ast_loc->push_child(child_ast);

                    symbol_dat sym_dat;
                    sym_dat.init((rule->pattern).ith(i), child_ast);
                    stack.push(sym_dat);
                    i = i + 1;
                }
                printf("parse nt ok\n");
            }
        }

        table.del();

        anyptr final_res;
        final_res = ast.evaluate_ast();
        return final_res;
    }

    static func anyptr _gram_rule_ret_lrec_elim_notail(clist_anyptr l) { anyptr r; r.init_null(); return r; }
    static func anyptr _gram_rule_ret_lrec_elim_lrec(clist_anyptr l) {
        void** tmp;
        void* old_bonus_dat;
        clist_anyptr -> anyptr old_res_func;
        void* tail_dat;
        tmp = ((l.remove((l.len())-1)).ptr) as void**;
        old_res_func = tmp[0] as typeof(old_res_func);
        old_bonus_dat = tmp[1];
        tail_dat = (l.remove((l.len())-1)).ptr;

        anyptr tmp2;
        tmp2.init_view(old_bonus_dat);
        l.append(tmp2);
        anyptr normal_output;
        normal_output = old_res_func(l);
        return _gram_rule_ret_lrec_elim_nlrec_closure(normal_output, tail_dat);
    }
    static func anyptr _gram_rule_ret_lrec_elim_nlrec_closure(anyptr prev_out, void* tail_dat) {
        if !tail_dat {
            return prev_out;
        }

    }
    static func anyptr _gram_rule_ret_lrec_elim_nlrec(clist_anyptr l) {
        void** tmp;
        tmp = ((l.ith((l.len())-1)).ptr) as void**;
        clist_anyptr -> anyptr old_res_func;
        anyptr old_bonus_dat;
        old_res_func = tmp[0] as typeof(old_res_func);
        old_bonus_dat.init_view(tmp[1]);
        clist_anyptr lcopy;
        lcopy.init();
        int i;
        i = 0;
        while i < (l.len()) {
            lcopy.append(l.ith(i));
        }
        lcopy.append(old_bonus_dat);
    }

    static func void remove_left_recursion(gram_rules* rules, string_list* nonterm_symbs) {
        int i;
        int ntlen;
        i = 0;
        ntlen = nonterm_symbs->len();
        gram_rules new_rules;
        new_rules.init();
        while i < ntlen {
            gram_rules lrec_rules; // left recursive rules
            gram_rules nlrec_rules; // non left recursive rules
            lrec_rules.init();
            nlrec_rules.init();

            int j;
            j = 0;
            while j < (rules->len()) {
                gram_rule_t* rule;
                rule = rules->ith(j);
                if (rule->result) == i {
                    if ((rule->pattern).len()) {
                        gram_symbol_t first_sym;
                        first_sym = (rule->pattern).ith(((rule->pattern).len()) - 1);
                        if (((first_sym.kind) as int) == 2) && // first_sym is a nonterminal
                            ((((first_sym.dat).NonTerm_dat).symb) == (rule->result)) {
                            if ((rule->pattern).len()) == 1 { // The rule is of the kind $A -> $A
                                rule->del();
                                free(rule);
                            } else {
                                lrec_rules.append(rule);
                            }
                        } else {
                            nlrec_rules.append(rule);
                        }
                    } else {
                        nlrec_rules.append(rule);
                    }
                }
                j = j + 1;
            }

            if lrec_rules.len() { // our nonterminal has left recursive rules
                char* new_nonterm_str;
                new_nonterm_str = (malloc(strlen(nonterm_symbs->ith(i)) + 1 + 10)) as char*;
                sprintf(new_nonterm_str, "lrec_elim_%s", nonterm_symbs->ith(i));
                int new_nonterm;
                new_nonterm = string_list_thingy(nonterm_symbs, new_nonterm_str); // we assume no name conflict
                gram_symbol_t new_sym;
                new_sym.set_nonterm(new_nonterm);
                j = 0;
                while j < (nlrec_rules.len()) {
                    gram_rule_t* rule;
                    rule = nlrec_rules.ith(j);
                    rule->add_nonterm(new_nonterm); // TODO: make a new function to fix our change
                    void** tmp;
                    tmp = (malloc(sizeof(*tmp))) as void**;
                    tmp[0] = (rule->result_function) as void*;
                    tmp[1] = rule->func_bonus_dat;
                    rule->func_bonus_dat = tmp as void*;
                    rule->result_function = _gram_rule_ret_lrec_elim_nlrec;
                    j = j + 1;
                }
                j = 0;
                while j < (lrec_rules.len()) {
                    gram_rule_t* rule;
                    rule = lrec_rules.ith(j);
                    (rule->pattern).remove(((rule->pattern).len())-1);
                    rule->add_nonterm(new_nonterm);
                    void** tmp;
                    tmp = (malloc(sizeof(*tmp))) as void**;
                    tmp[0] = (rule->result_function) as void*;
                    tmp[1] = rule->func_bonus_dat;
                    rule->func_bonus_dat = tmp as void*;
                    rule->result = new_nonterm;
                    rule->result_function = _gram_rule_ret_lrec_elim_lrec;
                    j = j + 1;
                }
                gram_rule_t* epsrule;
                epsrule = (malloc(sizeof(gram_rule_t))) as gram_rule_t*;
                epsrule->init(new_nonterm, _gram_rule_ret_lrec_elim_notail);
                lrec_rules.append(epsrule);
            }

            while nlrec_rules.len() {
                new_rules.append(nlrec_rules.pop());
            }
            while lrec_rules.len() {
                new_rules.append(lrec_rules.pop());
            }
            i = i + 1;
        }
        rules->del();
        *rules = new_rules;
    }
}


func gram_rule_t* make_rule(const char* str, clist_anyptr -> anyptr rule_result_function, string_list* nonterm_symbs) {
    
    char* tmp;
    if (str[0] != '$') || (str[1] == '$') {
        printf("rule initial symbol must be a nonterminal\n");
        exit(EXIT_FAILURE);
    }

    str = str + 1;

    gram_rule_t ret;
    (ret).init(string_list_thingy(nonterm_symbs, copy_string_until_char(&str, ' ')),
        rule_result_function);


    while (*str) && ((*str) == ' ') { str = str + 1; }
    if (str[0] != '-') || (str[1] != '>') {          // testing we have a "->" after first symbol
        printf("expected \"->\" after initial symbol of rule\n");
        exit(EXIT_FAILURE);
    }
    str = str + 2;

    while *str {
        while (*str) && ((*str) == ' ') { str = str + 1; }

        if str[0] == '$' && str[1] == '{' { // escape sequence exact
            str = str + 2;
            tmp = copy_string_until_char(&str, '}');
            ret.add_exact(tmp);
            free(tmp);
            tmp = nullptr;
        } elif str[0] == '$' && str[1] == '{' { // escape sequence terminal
            str = str + 2;
            tmp = copy_string_until_char(&str, '}');
            ret.add_term(tmp);
            free(tmp);
            tmp = nullptr;
        } elif str[0] == '$' { // nonterminal
            str = str + 1;
            ret.add_nonterm(string_list_thingy(nonterm_symbs, copy_string_until_char(&str, ' ')));
        } elif str[0] == '@' { // terminal
            str = str + 1;
            tmp = copy_string_until_char(&str, ' ');
            ret.add_term(tmp);
            free(tmp);
            tmp = nullptr;
        } else { // exact
            tmp = copy_string_until_char(&str, ' ');
            ret.add_exact(tmp);
            free(tmp);
            tmp = nullptr;
        }
    }
    
    gram_rule_t* ptrret;
    ptrret = (malloc(sizeof(gram_rule_t))) as gram_rule_t*;
    *ptrret = ret;
    return ptrret;
}

