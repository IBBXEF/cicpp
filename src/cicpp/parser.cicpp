
#include "src/cicpp/clist.cicpp"
#include "src/cicpp/anyptr.cicpp"
#include "src/cicpp/set.cicpp"
#include "src/cicpp/lexer.cicpp"
#include_C "limits.h"
#include_C "stdio.h"
#include_C "string.h"


// if the string is in the list, the pointer is freed and the index returned. otherwise, it is added to the list and its idex is returned
fun int string_list_thingy(string_list* l, char* str) {
    int i = string_list_find(*l, str);
    if i < 0 {
        l->append(str);
        return l->len() - 1;
    }
    free(str);
    return i;
}
fun char* copy_string_until_char(const char** str, char c) {
    const char* base = *str;
    while **str && **str != c {
        *str = *str + 1;
    }
    int len = *str - base;
    char* ret = malloc(len + 1) as char* ;
    ret[len] = '\0';
    int i = 0;
    while i < len {
        ret[i] = base[i];
        i = i + 1;
    }
    return ret;
}

type gram_rule_t {

    specialize clist<gram_rule_t*> as gram_rules

    type gram_symbol_t {
        Term { token tok; };
        Exact { token tok; };
        NonTerm { int symb; };

        fun void set_nonterm(int i) {
            kind = NonTerm;
            dat.NonTerm_dat.symb = i;
        }
        fun void set_term(token t) {
            kind = Term;
            dat.Term_dat.tok = t;
        }
        fun void set_exact(token t) {
            kind = Exact;
            dat.Term_dat.tok = t;
        }
        fun bool match_tok(token t) {
            if kind == Exact {
                return t.eq(dat.Exact_dat.tok);
            } elif kind == Term {
                return dat.Exact_dat.tok.kind == t.kind;
            } else {
                return false;
            }
        }
        fun bool includes(gram_symbol_t s) {
            if kind == NonTerm || s.kind == NonTerm {
                printf("invalid inclusion test of gram_symbol_t\n");
                exit(EXIT_FAILURE);
            }
            if s.kind == Exact || kind == Term {
                return match_tok(s.dat.Exact_dat.tok);
            }
            return false;
        }
        fun bool eq(gram_symbol_t b) {
            if kind != b.kind {
                return false;
            }
            if kind == NonTerm { // NonTerm
                return dat.NonTerm_dat.symb == b.dat.NonTerm_dat.symb;
            } elif kind == Exact {
                return dat.Exact_dat.tok.eq(b.dat.Exact_dat.tok);
            } else {
                return dat.Term_dat.tok.kind == b.dat.Term_dat.tok.kind;
            }
        }

        fun void print(string_list nonterm_symbs) {
            if kind == Term {
                printf("@");
                dat.Term_dat.tok.print();
            } elif kind == Exact {
                dat.Exact_dat.tok.print();
            } else {
                printf("$%s", nonterm_symbs.ith(dat.NonTerm_dat.symb) );
            }
        }
    }
    
    specialize clist<gram_symbol_t> as symlist

    type parsing_table {
        type sym_rule_pair { gram_symbol_t s; gram_rule_t* r; }
        specialize clist<sym_rule_pair> as pairlist
        pairlist* tables;
        int _n_nonterms;
        fun void init_empty(int n_nonterms) {
            tables = malloc(sizeof(pairlist)*n_nonterms) as pairlist*;
            int i = 0;
            while i < n_nonterms {
                tables[i].init();
                i = i + 1;
            }
            _n_nonterms = n_nonterms;
        }
        fun void add_entry(gram_symbol_t s, int nonterm, gram_rule_t* r, bool ignore_conflicts, const char* nonterm_name) {
            if (s.kind as int) == 2 { // 2 = Nonterminal
                printf("invalid gram symbol for rule table: it is Nonterminal %s\n", nonterm_name);
                exit(EXIT_FAILURE);
            }
            if nonterm < 0 || nonterm >= _n_nonterms {
                printf("invalid nonterminal index %d in parsing table\n", nonterm);
                exit(EXIT_FAILURE);
            }
            int i = 0;
            pairlist table;
            table = tables[nonterm];
            while i < table.len() {
                gram_symbol_t s2;
                s2 = table.ith(i).s;
                if s2.includes(s) || s.includes(s2) {
                    if !r->eq(*table.ith(i).r) { // there is a real conflict
                        string_list empty;
                        empty.init();
                        printf("conflicting entry in the parsing table for nonterm $%s and symbol ", nonterm_name);
                        s.print(empty);
                        if ignore_conflicts {
                            printf(", conflict ignored\n");
                            // return; // TODO: allow return statements without values
                        } else {
                            printf("\n");
                            exit(EXIT_FAILURE);
                        }
                    }
                }
                i = i + 1;
            }
            sym_rule_pair pair;
            pair.s = s;
            pair.r = r;
            tables[nonterm].push(pair);
        }
        fun gram_rule_t* lookup(token t, int nonterm) {
            if nonterm < 0 || nonterm >= _n_nonterms {
                printf("invalid nonterminal index %d in parsing table\n", nonterm);
                exit(EXIT_FAILURE);
            }
            int i = 0;
            pairlist tab;
            tab = tables[nonterm];
            while i < tab.len() {
                if tab.ith(i).s.match_tok(t) {
                    return tab.ith(i).r;
                }
                i = i + 1;
            }
            return nullptr;
        }
        fun void del() {
            int i = 0;
            while i < _n_nonterms {
                tables[i].del(); // the list's elements don't allocate memory
                i = i + 1;
            }
        }
    }


    symlist pattern; // a nonempty list of symbols
    int result;

    // user-defined "result function" that will turn the matched pattern into the result.
    // the input pointers's ownership belongs to the function, but not the list itself
    clist_voidptr => void* result_function; // the grammar gives priority to * over =>
    void* func_bonus_dat; // optionnal additionnal data that will be given to the function as the last element of the clist.

    type parsed_ast {
        Leaf { token t; };
        Node { clist_voidptr childrens; gram_rule_t* origin_rule; };
        Unknown;

        fun void init_unknown() {
            kind = Unknown;
        }
        fun void init_node(gram_rule_t* origin_rule) {
            kind = Node;
            dat.Node_dat.origin_rule = origin_rule;
            dat.Node_dat.childrens.init();
        }
        fun void init_leaf(token t) {
            kind = Leaf;
            dat.Leaf_dat.t = t;
        }
        fun void push_child(parsed_ast* child) {
            dat.Node_dat.childrens.push(child);
        }
        fun void append_child(parsed_ast* child) {
            dat.Node_dat.childrens.append(child);
        }

        fun void* evaluate_ast() {
            void* ret;
            if kind == Leaf {
                ret = &dat.Leaf_dat.t;
                return ret;
            } elif kind == Node { // Node
                clist_voidptr args;
                args.init();
                int i = 0;
                clist_voidptr kids;
                kids = dat.Node_dat.childrens;
                while i < kids.len() {
                    parsed_ast* child;
                    child = kids.ith(i) as parsed_ast*;
                    args.append(child->evaluate_ast());
                    i = i + 1;
                }
                void* tmp = dat.Node_dat.origin_rule->func_bonus_dat;
                args.append(tmp);
                void* res;
                res = dat.Node_dat.origin_rule->result_function(args);
                args.del();
                return res;
            } else { // Unknown
                printf("tried to evaluate unknown ast node\n");
                exit(EXIT_FAILURE);
            }
        }
    }

    type symbol_dat {

        specialize clist<symbol_dat*> as symdatptrlist

        parsed_ast* ast_loc;
        gram_symbol_t sym;

        fun void update_tok_ast(token t) {
            ast_loc->init_leaf(t);
        }
        fun void init(gram_symbol_t symb, parsed_ast* ast) {
            sym = symb;
            ast_loc = ast;
        }
    }

    specialize clist<symbol_dat> as symdatlist

    fun void init(int rule_result, clist_voidptr => void* rule_result_function) {
        result = rule_result;
        result_function = rule_result_function;
        func_bonus_dat = nullptr;
        pattern.init();
    }
    fun void init_bonus_func_data(int rule_result, clist_voidptr => void* rule_result_function, void* result_func_bonus_dat) {
        init(rule_result, rule_result_function);
        func_bonus_dat = result_func_bonus_dat;
    }
    fun void del() {
        pattern.del(); // gram_symbol_t does not perform any allocations
    }
    fun bool eq(gram_rule_t r) {
        if result != r.result {
            return false;
        }
        if pattern.len() != r.pattern.len() {
            return false;
        }
        int i = 0;
        while i < pattern.len() {
            gram_symbol_t s1;
            gram_symbol_t s2;
            s1 = pattern.ith(i);
            s2 = r.pattern.ith(i);
            if !s1.eq(s2) {
                return false;
            }
            i = i + 1;
        }
        if result_function != r.result_function {
            // TODO: readd warnings later
            printf("WARNING: identical rules with different result functions, assuming they are identical\n");
            exit(EXIT_FAILURE);
            return false;
        }
        if func_bonus_dat != r.func_bonus_dat {
            printf("WARNING: identical rules with different bonus dat, assuming they are identical\n");
            exit(EXIT_FAILURE);
            return false;
        }
        return true;
    }
    fun void add_nonterm(int nt) {
        gram_symbol_t sym;
        sym.set_nonterm(nt);
        pattern.push(sym); // pattern is in reverse order
    }
    fun void add_term(const char* str) {
        toklist l;
        l = lex_string(str);
        while l.len() {
            gram_symbol_t sym;
            sym.set_term(l.pop());
            pattern.push(sym); // pattern is in reverse order
        }
    }
    fun void add_exact(const char* str) {
        toklist l;
        l = lex_string(str);
        while l.len() {
            gram_symbol_t sym;
            sym.set_exact(l.pop());
            pattern.push(sym); // pattern is in reverse order
        }
    }

    fun void print(string_list nonterm_symbs) {
        printf("$%s -> ", nonterm_symbs.ith(result));
        int i = 0;
        while i < pattern.len() {
            if i {
                printf(" ");
            }
            pattern.ith(pattern.len() - i - 1).print(nonterm_symbs); // pattern is in reverse order
            i = i + 1;
        }
        printf("\n");
    }

    specialize comparable_ptr<gram_symbol_t> as term_ptr
    specialize set<term_ptr> as term_set

    static fun term_set* compute_first_sets(gram_rules rules, string_list nonterm_symbs, bool only_direct_first = false) {
        term_set* ret;
        ret = malloc(sizeof(term_set)*(nonterm_symbs.len() + rules.len())) as term_set*;
        term_set* Fi = ret;
        term_set* FiRules = ret + nonterm_symbs.len();
        term_ptr tmp_ptr;
        term_ptr epsilon;
        tmp_ptr.init_null();
        epsilon.init_null();
        int i = 0;
        while i < nonterm_symbs.len() {
            Fi[i].init();
            i = i + 1;
        }
        i = 0;
        while i < rules.len() {
            FiRules[i].init();
            i = i + 1;
        }

        // populate Fi
        bool not_finished = true;
        while not_finished {
            not_finished = false;
            i = 0;
            while i < rules.len() {
                gram_rule_t* rule = rules.ith(i);
                term_set* cFi = Fi + rule->result; // current Fi

                term_set addFi;
                addFi.init();
                int j = rule->pattern.len() - 1; // pattern is stored in reverse order
                while 0 <= j {
                    gram_symbol_t* sy = rule->pattern.ith_ref(j);
                    if (sy->kind as int) != 2 { // terminal or exact
                        tmp_ptr.init_ptr(sy);
                        addFi.add(tmp_ptr);
                        j = -2; // we break the loop
                    } elif !only_direct_first { // nonterminal
                        term_set* oFi = Fi + sy->dat.NonTerm_dat.symb; // other Fi
                        if oFi->contains(epsilon) {
                            tmp_ptr.init_null();
                            oFi->remove(epsilon);
                            addFi.union_with(*oFi);
                            oFi->add(epsilon);
                        } else {
                            addFi.union_with(*oFi);
                            j = -2; // we break out of the loop
                        }
                    } else {
                        j = -2; // we break out of the loop
                    }
                    j = j - 1;
                }
                if j == -1 {
                    addFi.add(epsilon); // we add epsilon
                }
                FiRules[i].del();
                FiRules[i] = addFi;
                not_finished = cFi->union_with(addFi) || not_finished;
                i = i + 1;
            }
        }
        return ret;
    }
    static fun parsing_table make_parsing_table(gram_rules rules, string_list nonterm_symbs, int goal_nonterm, gram_symbol_t stop_symbol, bool ignore_conflicts) {
        printf("making parsing table for %d rules\n", rules.len());
        // create an initialize Fi
        term_set* Fi = compute_first_sets(rules, nonterm_symbs);
        term_set* FiRules = Fi + nonterm_symbs.len();

        term_ptr tmp_ptr;
        term_ptr epsilon;
        tmp_ptr.init_null();
        epsilon.init_null();

        // create an initialize Fo
        term_set* Fo = malloc(sizeof(term_set)*nonterm_symbs.len()) as term_set*;
        int i = 0;
        while i < nonterm_symbs.len() {
            Fo[i].init();
            i = i + 1;
        }
        tmp_ptr.init_ptr(&stop_symbol);
        Fo[goal_nonterm].add(tmp_ptr);

        // populate Fo
        bool not_finished = true;
        while not_finished {
            not_finished = false;
            i = 0;
            while i < rules.len() {
                gram_rule_t* rule = rules.ith(i);
                term_set* cFo = Fo + rule->result; // current Fi

                term_set wFi;
                wFi.init();
                wFi.add(epsilon);
                int j = 0; // we iterate the pattern in reverse order
                while j < rule->pattern.len() {
                    gram_symbol_t* sy = rule->pattern.ith_ref(j);
                    if (sy->kind as int) != 2 { // terminal or exact
                        wFi.del();
                        wFi.init();
                        tmp_ptr.init_ptr(sy);
                        wFi.add(tmp_ptr);
                    } else { // nonterminal
                        term_set* oFo = Fo + sy->dat.NonTerm_dat.symb; // other Fi
                        if wFi.contains(epsilon) {
                            not_finished = oFo->union_with(*cFo) || not_finished;
                        }
                        not_finished = oFo->union_with(wFi) || not_finished; // this may add epsilon to the set, but we'll clean it later

                        term_set* oFi = Fi + sy->dat.NonTerm_dat.symb; // other Fi
                        if oFi->contains(epsilon) {
                            oFi->remove(epsilon);
                            wFi.union_with(*oFi);
                            oFi->add(epsilon);
                        } else {
                            wFi.del();
                            wFi.init();
                            wFi.union_with(*oFi);
                        }
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
        }

        parsing_table ret;
        ret.init_empty(nonterm_symbs.len());

        i = 0;
        while i < nonterm_symbs.len() {
            term_set cFo = Fo[i];
            cFo.remove(epsilon); // we remove the epsilons that we may have added before
            int j = 0;
            while j < rules.len() {
                if rules.ith(j)->result == i {
                    term_set cFi = FiRules[j];

                    term_set tmp;
                    tmp.init();

                    tmp.union_with(cFi);
                    tmp.remove(epsilon);

                    if cFi.contains(epsilon) {
                        tmp.union_with(cFo);
                    }

                    int k = 0;
                    while k < tmp.elts.len() {
                        gram_symbol_t* s = tmp.elts.ith(k).ptr;
                        ret.add_entry(*s, i, rules.ith(j), ignore_conflicts, nonterm_symbs.ith(i));
                        k = k + 1;
                    }
                }
                j = j + 1;
            }
            cFo.del();
            Fi[i].del();
            i = i + 1;
        }
        i = 0;
        while i < rules.len() {
            FiRules[i].del();
            i = i + 1;
        }
        free(Fi); // FiRules is freed too
        free(Fo);
        return ret;
    }

    static fun void* parse_with_rules(toklist* l, int goal_nonterm, gram_symbol_t stop_symbol, string_list nonterm_symbs, parsing_table table) {
        if (stop_symbol.kind as int) == 2 { // 2 = Nonterminal
            printf("invalid stop symbol: it is Nonterminal\n");
            exit(EXIT_FAILURE);
        }
        symdatlist stack;
        parsed_ast ast;
        stack.init();
        ast.init_unknown();

        gram_symbol_t sym_tmp;
        sym_tmp.set_nonterm(goal_nonterm);
        symbol_dat sym_dat_tmp;
        sym_dat_tmp.init(sym_tmp, &ast);
        stack.push(sym_dat_tmp);

        token stop_token;
        if (stop_symbol.kind as int) == 1 { // Exact
            stop_token = stop_symbol.dat.Exact_dat.tok;
        } else {
            stop_token = stop_symbol.dat.Term_dat.tok;
        }

        while stack.len() > 0 {
            symbol_dat stacktop;
            stacktop = stack.pop();
            token inptop;
            if l->len() && !stop_symbol.match_tok(l->ith(0)) {
                inptop = l->ith(0);
            } else {
                inptop = stop_token;
            }

            if (stacktop.sym.kind as int) != 2 { // the top element of our stack is a token
                if !stacktop.sym.match_tok(inptop) {
                    printf("failed to parse: got token ");
                    inptop.print();
                    printf(" but expected ");
                    stacktop.sym.print(nonterm_symbs);
                    printf("\n");
                    exit(EXIT_FAILURE);
                }
                stacktop.update_tok_ast(inptop);
                *l = l->tail();
                // printf("parse tok ok\n");
            } else { // the element at the top of our stack is a nonterminal
                int nt = stacktop.sym.dat.NonTerm_dat.symb; // current nonterminal
                gram_rule_t* rule = table.lookup(inptop, nt);
                if rule == nullptr {
                    printf("failed to parse: no rule found for nonterminal $%s with token ", nonterm_symbs.ith(nt));
                    inptop.print();
                    printf("\n");
                    exit(EXIT_FAILURE);
                }
                
                parsed_ast* ast_loc = stacktop.ast_loc;

                ast_loc->init_node(rule);
                int i = 0;
                while i < rule->pattern.len() {
                    parsed_ast* child_ast = malloc(sizeof(parsed_ast)) as parsed_ast*;
                    child_ast->init_unknown();
                    ast_loc->push_child(child_ast);

                    symbol_dat sym_dat;
                    sym_dat.init(rule->pattern.ith(i), child_ast);
                    stack.push(sym_dat);
                    i = i + 1;
                }
                // printf("parse nt ok\n");
            }
        }

        return ast.evaluate_ast();
    }

    static fun void* _gram_rule_ret_lrec_elim_notail(clist_voidptr l) { return nullptr; }
    static fun void* _gram_rule_ret_lrec_elim_lrec(clist_voidptr l) {
        void** tmp = l.remove((l.len())-1) as void**;
        void* old_res_func = tmp[0];
        void* old_bonus_dat = tmp[1];
        void* tail_dat = l.remove(l.len()-1);

        clist_voidptr* lcopy = malloc(sizeof(clist_voidptr)) as clist_voidptr*;
        lcopy->init();
        int i = 0;
        while i < l.len() {
            lcopy->append(l.ith(i));
            i = i + 1;
        }
        lcopy->append(old_bonus_dat);
        lcopy->append(old_res_func);
        lcopy->append(tail_dat);

        void* ret = lcopy;
        return ret;
    }
    static fun void* _gram_rule_ret_lrec_elim_nlrec_closure(void* prev_out, clist_voidptr* tail_dat) {
        if !tail_dat {
            return prev_out;
        }
        void* other_tail_dat = tail_dat->remove(tail_dat->len() - 1);
        clist_voidptr => void* old_res_func = tail_dat->remove(tail_dat->len() - 1) as typeof(old_res_func);
        void* old_bonus_dat = tail_dat->remove(tail_dat->len() - 1);

        tail_dat->append(old_bonus_dat);
        tail_dat->push(prev_out);
        void* combined_out = old_res_func(*tail_dat);

        void* ret = _gram_rule_ret_lrec_elim_nlrec_closure(combined_out, other_tail_dat as typeof(tail_dat));

        free(tail_dat); // this is probably a memory leak
        return ret;
    }
    static fun void* _gram_rule_ret_lrec_elim_nlrec(clist_voidptr l) {
        clist_voidptr lcopy;
        lcopy.init();
        int i = 0;
        while i < l.len() {
            lcopy.append(l.ith(i));
            i = i + 1;
        }
        void** tmp = lcopy.remove(lcopy.len() - 1) as void**;
        clist_voidptr* tail_dat = lcopy.remove(lcopy.len() - 1) as clist_voidptr*;
        clist_voidptr => void* old_res_func = tmp[0] as typeof(old_res_func);
        void* old_bonus_dat = tmp[1];
        lcopy.append(old_bonus_dat);
        void* normal_output = old_res_func(lcopy);
        lcopy.del(); // memory leak ?

        void* ret =  _gram_rule_ret_lrec_elim_nlrec_closure(normal_output, tail_dat);
        return ret;
    }
    static fun void* _gram_rule_ret_lrec_any_uninline(clist_voidptr l) {
        void** tmp = l.remove(l.len() - 1) as void**;
        clist_voidptr => void* old_res_func1 = tmp[0] as typeof(old_res_func1);
        void* old_bonus_dat1 = tmp[1];
        clist_voidptr => void* old_res_func2 = tmp[2] as typeof(old_res_func2);
        void* old_bonus_dat2 = tmp[3];
        int* old1_len = tmp[4] as int*;

        clist_voidptr lcopy1;
        lcopy1.init();
        clist_voidptr lcopy2;
        lcopy2.init();
        int i = 0;
        while i < *old1_len {
            lcopy1.append(l.ith(i));
            i = i + 1;
        }
        while i < l.len() {
            lcopy2.append(l.ith(i));
            i = i + 1;
        }
        lcopy1.append(old_bonus_dat1);
        void* res1 = old_res_func1(lcopy1);
        
        lcopy1.del();
        lcopy2.push(res1);
        lcopy2.append(old_bonus_dat2);

        res1 = old_res_func2(lcopy2);
        lcopy2.del();
        return res1;
    }
    static fun void* _gram_rule_ret_factor_accu(clist_voidptr l) {
        clist_voidptr* lcopy = malloc(sizeof(clist_voidptr)) as clist_voidptr*;
        *lcopy = l.deepcopy();
        return lcopy;
    }
    static fun void* _gram_rule_ret_factor_join(clist_voidptr l) {
        if l.remove(l.len() - 1) {
            printf("Impossible error: join bonus data not null\n");
            exit(EXIT_FAILURE);
        }
        clist_voidptr* acc = l.remove(l.len() - 1) as clist_voidptr*;
        while acc->len() {
            l.append(acc->pop());
        }
        free(acc);
        void** tmp = l.remove(l.len() - 1) as void**;

        clist_voidptr => void* old_res_func = tmp[0] as typeof(old_res_func);
        void* old_bonus_dat = tmp[1];
        l.append(old_bonus_dat);

        void* ret = old_res_func(l);
        return ret;
    }

    static fun void remove_direct_left_recursion(gram_rules* rules, string_list* nonterm_symbs) {
        int i = 0;
        int ntlen = nonterm_symbs->len();
        gram_rules new_rules;
        new_rules.init();
        while i < ntlen {
            gram_rules lrec_rules; // left recursive rules
            gram_rules nlrec_rules; // non left recursive rules
            lrec_rules.init();
            nlrec_rules.init();

            int j = 0;
            while j < rules->len() {
                gram_rule_t* rule = rules->ith(j);
                if rule->result == i {
                    if rule->pattern.len() {
                        gram_symbol_t first_sym = rule->pattern.ith(rule->pattern.len() - 1);
                        if (first_sym.kind as int) == 2 && // first_sym is a nonterminal
                            first_sym.dat.NonTerm_dat.symb == rule->result {
                            if rule->pattern.len() == 1 { // The rule is of the kind $A -> $A
                                rule->del();
                                free(rule);
                            } else {
                                lrec_rules.append(rule);
                            }
                        } else {
                            nlrec_rules.append(rule);
                        }
                    } else {
                        nlrec_rules.append(rule);
                    }
                }
                j = j + 1;
            }

            if lrec_rules.len() { // our nonterminal has left recursive rules
                char* new_nonterm_str = malloc(strlen(nonterm_symbs->ith(i)) + 1 + 50) as char*;
                sprintf(new_nonterm_str, "tail%x_%s", nonterm_symbs->len(), nonterm_symbs->ith(i)); // to avoid name conflicts
                int new_nonterm = string_list_thingy(nonterm_symbs, new_nonterm_str); // we assume no name conflict
                if new_nonterm + 1 != nonterm_symbs->len() {
                    printf("name conflict!!!\n");
                    exit(EXIT_FAILURE);
                }
                gram_symbol_t new_sym;
                new_sym.set_nonterm(new_nonterm);
                j = 0;
                while j < nlrec_rules.len() {
                    gram_rule_t* rule = nlrec_rules.ith(j);
                    rule->add_nonterm(new_nonterm);
                    void** tmp = malloc(sizeof(*tmp) * 2) as void**;
                    tmp[0] = rule->result_function as void*;
                    tmp[1] = rule->func_bonus_dat;
                    rule->func_bonus_dat = tmp as void*;
                    rule->result_function = _gram_rule_ret_lrec_elim_nlrec;
                    j = j + 1;
                }
                j = 0;
                while j < lrec_rules.len() {
                    gram_rule_t* rule = lrec_rules.ith(j);
                    rule->pattern.remove(rule->pattern.len()-1);
                    rule->add_nonterm(new_nonterm);
                    void** tmp = malloc(sizeof(*tmp)*2) as void**;
                    tmp[0] = rule->result_function as void*;
                    tmp[1] = rule->func_bonus_dat;
                    rule->func_bonus_dat = tmp as void*;
                    rule->result = new_nonterm;
                    rule->result_function = _gram_rule_ret_lrec_elim_lrec;
                    j = j + 1;
                }
                gram_rule_t* epsrule = malloc(sizeof(gram_rule_t)) as gram_rule_t*;
                epsrule->init(new_nonterm, _gram_rule_ret_lrec_elim_notail);
                lrec_rules.append(epsrule);
            }

            while nlrec_rules.len() {
                new_rules.append(nlrec_rules.pop());
            }
            while lrec_rules.len() {
                new_rules.append(lrec_rules.pop());
            }
            i = i + 1;
        }
        rules->del();
        *rules = new_rules;
    }
    // inlines rule1 into rule2 at the start of the pattern (so its last element as the order is reversed)
    static fun void inline_rule(gram_rule_t* rule1, gram_rule_t* rule2) {
        gram_symbol_t first_sym = rule2->pattern.ith(rule2->pattern.len() - 1);
        if (first_sym.kind as int) != 2 ||
            first_sym.dat.NonTerm_dat.symb != rule1->result {
            printf("incompatible rules for inlining\n");
            exit(EXIT_FAILURE);
        }
        rule2->pattern.remove(rule2->pattern.len() - 1);
        void** tmp = malloc(sizeof(*tmp)*5) as void**;
        tmp[0] = rule1->result_function as void*;
        tmp[1] = rule1->func_bonus_dat as void*;
        tmp[2] = rule2->result_function as void*;
        tmp[3] = rule2->func_bonus_dat as void*;
        int* tmpint = malloc(sizeof(*tmpint)) as int*;
        *tmpint = rule1->pattern.len();
        tmp[4] = tmpint as void*;
        rule2->result_function = _gram_rule_ret_lrec_any_uninline;
        rule2->func_bonus_dat = tmp as void*;
        int k = 0;
        while k < rule1->pattern.len() {
            rule2->pattern.append(rule1->pattern.ith(k));
            k = k + 1;
        }
    }
    // does not support potentially epsilon nonterminals at the start of patterns
    static fun void remove_all_left_recursion(gram_rules* rules, string_list* nonterm_symbs) {
        bool has_changed = true;
        while has_changed {
            has_changed = false;
            int i = 0;
            while i < rules->len() {
                gram_rule_t* rule = rules->ith(i);
                if rule->pattern.len() {
                    gram_symbol_t first_sym = rule->pattern.ith(rule->pattern.len() - 1);
                    if (first_sym.kind as int) == 2 && // first_sym is a nonterminal
                        first_sym.dat.NonTerm_dat.symb < rule->result {
                        
                        int j = 0;
                        while j < rules->len() {
                            gram_rule_t rule2 = *rules->ith(j);
                            if rule2.result == first_sym.dat.NonTerm_dat.symb {
                                gram_rule_t* newrule = malloc(sizeof(gram_rule_t)) as gram_rule_t*;
                                *newrule = *rule;
                                newrule->pattern = rule->pattern.deepcopy();
                                inline_rule(&rule2, newrule);
                                rules->append(newrule);
                            }
                            j = j + 1;
                        }

                        rule->del();
                        free(rule);
                        rules->remove(i);
                        has_changed = true;
                        i = i - 1;
                    }
                }
                remove_direct_left_recursion(rules, nonterm_symbs); // this is very dumb but works
                i = i + 1;
            }
        }
    }
    static fun void remove_useless_rules(gram_rules* rules, string_list nonterm_symbs) {
        // TODO: add warnings for nonterminals with no production rules
        int i = 0;
        while i < rules->len() { // remove shadow copy of rules
            gram_rule_t* rule1 = rules->ith(i);
            int j = i+1;
            while j < rules->len() {
                gram_rule_t* rule2 = rules->ith(j);
                if rule1 == rule2 {
                    printf("WARNING: found shadow copy of following rule:");
                    rule2->print(nonterm_symbs);
                    exit(-1);
                    rules->remove(j);
                    j = j - 1;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        i = 0;
        while i < rules->len() { // remove doubled rules
            gram_rule_t* rule1 = rules->ith(i);
            int j = i+1;
            while j < rules->len() {
                gram_rule_t* rule2 = rules->ith(j);
                if rule1->eq(*rule2) {
                    rules->remove(j);
                    rule2->del();
                    free(rule2);
                    j = j - 1;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        i = 0;
        while i < rules->len() { // remove identity rules
            gram_rule_t* rule1 = rules->ith(i);
            symlist sl = rule1->pattern;
            if sl.len() == 1
                && (sl.ith(0).kind as int) == 2
                && sl.ith(0).dat.NonTerm_dat.symb == rule1->result {
                rules->remove(i);
                rule1->del();
                free(rule1);
                i = i - 1;
            }
            i = i + 1;
        }
    }
    static fun bool _nonterm_inclusion(gram_rules* rules, int nt1, int nt2) {
        bool ret = true;
        int i = 0;
        while i < rules->len() {
            gram_rule_t rule1 = *rules->ith(i);
            if rule1.result == nt1 {
                bool found_match = false;
                int j = i+1;
                while j < rules->len() {
                    gram_rule_t rule2 = *rules->ith(j);
                    if rule2.result == nt2 {
                        rule2.pattern = rule2.pattern.deepcopy();
                        int k = 0;
                        while k < rule2.pattern.len() {
                            gram_symbol_t* s = rule2.pattern.ith_ref(k);
                            if (s->kind as int) == 2 && s->dat.NonTerm_dat.symb == nt2 {
                                s->dat.NonTerm_dat.symb = nt1;
                            }
                            k = k + 1;
                        }
                        rule2.result = nt1;
                        found_match = found_match || rule1.eq(rule2); // TODO: incorrect if rule1 has nt2 in its pattern
                        rule2.pattern.del();
                    }
                    j = j + 1;
                }
                ret = ret && found_match;
            }
            i = i + 1;
        }
        return ret;
    }
    static fun void fuse_identical_nonterms(gram_rules* rules, string_list* nonterm_symbs) {
        int n1 = 0;
        while n1 < nonterm_symbs->len() {
            int n2 = n1+1;
            while n2 < nonterm_symbs->len() {
                if _nonterm_inclusion(rules, n1, n2) && _nonterm_inclusion(rules, n2, n1) {
                    // nonterminals have identical rules
                    if n2+1 == nonterm_symbs->len() {
                        nonterm_symbs->remove(n2); // TODO: fix potential memory leak ?
                    }
                    int i = 0;
                    while i < rules->len() {
                        gram_rule_t* rule = rules->ith(i);
                        if rule->result == n2 {
                            rules->remove(i);
                            rule->del();
                            free(rule);
                            i = i - 1;
                        } else {
                            int k = 0;
                            while k < rule->pattern.len() {
                                gram_symbol_t* s = rule->pattern.ith_ref(k);
                                if (s->kind as int) == 2 && s->dat.NonTerm_dat.symb == n2 {
                                    s->dat.NonTerm_dat.symb = n1;
                                }
                                k = k + 1;
                            }
                        }
                        i = i + 1;
                    }
                }
                n2 = n2 + 1;
            }
            n1 = n1 + 1;
        }
    }
    static fun void order_rules_by_nonterm(gram_rules* rules, string_list nonterm_symbs) {
        int i = 0;
        gram_rules new_rules;
        new_rules.init();
        while i < nonterm_symbs.len() {
            int j = 0;
            while j < rules->len() {
                gram_rule_t* rule = rules->ith(j);
                if rule->result == i {
                    new_rules.append(rule);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        rules->del();
        *rules = new_rules;
    }
    // input rules must be left-recursion free and ordered by nonterminals. output is still ordered.
    static fun bool apply_direct_left_factoring(gram_rules* rules, string_list* nonterm_symbs, int max_iter = INT_MAX) {
        bool changed = false;
        int nt = 0;
        int rules_len = rules->len();
        int i = 0;
        while i < rules_len {
            gram_rule_t* rule1 = rules->ith(i);
            int r1_pt_len = rule1->pattern.len();
            int nt = rule1->result;
            if rule1->pattern.len() {
                bool do_factorize = false;
                int j = i+1;
                while j < rules_len && rules->ith(j)->result == nt {
                    gram_rule_t* rule2 = rules->ith(j);
                    int r2_pt_len = rule2->pattern.len();
                    if rule2->pattern.len() {
                        if rule1->pattern.ith(r1_pt_len-1).eq(rule2->pattern.ith(r2_pt_len-1)) {
                            do_factorize = true;
                            j = INT_MAX-1;
                        }
                    }
                    j = j + 1;
                }
                if do_factorize {
                    changed = true;

                    char* new_nonterm_str = malloc(strlen(nonterm_symbs->ith(nt)) + 1 + 10) as char*;
                    sprintf(new_nonterm_str, "lf%x_%s", nonterm_symbs->len(), nonterm_symbs->ith(nt));
                    int new_nonterm = string_list_thingy(nonterm_symbs, new_nonterm_str); // we assume no name conflict
                    if new_nonterm+1 != nonterm_symbs->len() {
                        printf("name conflict!\n");
                        exit(EXIT_FAILURE);
                    }
                    
                    gram_rule_t* newrule = malloc(sizeof(gram_rule_t)) as gram_rule_t*;
                    newrule->init_bonus_func_data(nt, _gram_rule_ret_factor_join, nullptr);
                    newrule->pattern.push(rule1->pattern.ith(r1_pt_len-1));
                    newrule->add_nonterm(new_nonterm);
                    // printf("factorizing $%s on ", nonterm_symbs->ith(nt));
                    // ((rule1->pattern).ith(r1_pt_len-1)).print(*nonterm_symbs);
                    // printf("\n");

                    int j = i; // if there is a conflict, i is the first one conflicting
                    while j < rules_len && rules->ith(j)->result == nt {
                        gram_rule_t* rule2 = rules->ith(j);
                        int r2_pt_len = rule2->pattern.len();
                        if rule2->pattern.len() {
                            if newrule->pattern.ith(1).eq(rule2->pattern.ith(r2_pt_len-1)) {
                                void** tmp = malloc(sizeof(*tmp)*2) as void**;
                                tmp[0] = rule2->result_function as void*;
                                tmp[1] = rule2->func_bonus_dat;
                                rule2->result = new_nonterm;
                                rule2->result_function = _gram_rule_ret_factor_accu;
                                rule2->func_bonus_dat = tmp as void*;
                                rule2->pattern.remove(r2_pt_len-1);
                            }
                        }
                        j = j + 1;
                    }
                    rules->append(newrule);
                    i = j-1; // like this, next iteration will happen on next nonterm and us having mixed nonterms will not matter.
                }
            }
            i = i + 1;
        }
        order_rules_by_nonterm(rules, *nonterm_symbs);
        if !changed || max_iter <= 1 {
            return changed;
        } else {
            apply_direct_left_factoring(rules, nonterm_symbs, max_iter-1);
            return true;
        }
    }
    // input rules must be left-recursion free
    static fun void fix_factoring_conflicts(gram_rules* rules, string_list* nonterm_symbs, int max_iter = 50) {
        max_iter = max_iter-1;
        order_rules_by_nonterm(rules, *nonterm_symbs);
        bool has_changed = apply_direct_left_factoring(rules, nonterm_symbs, INT_MAX);

        term_set* Fi = compute_first_sets(*rules, *nonterm_symbs);
        term_set* Fi_rules = Fi + nonterm_symbs->len();
        term_set* Fi_direct = compute_first_sets(*rules, *nonterm_symbs, true);

        term_ptr epsilon;
        epsilon.init_null();
        term_set indirect_first;
        indirect_first.init();
        int last_nonterm = -1;
        int i = 0;
        int rules_len = rules->len();
        int start_of_nonterm;
        while i < rules_len {
            gram_rule_t* rule = rules->ith(i);
            if rule->result != last_nonterm {
                last_nonterm = rule->result;
                start_of_nonterm = i;
                indirect_first.del();
                indirect_first.init();
            }
            if rule->pattern.len() >= 1 {
                gram_symbol_t first_sym;
                first_sym = rule->pattern.ith(rule->pattern.len() - 1);
                if (first_sym.kind as int) == 2 {
                    if Fi_rules[i].test_intersect(Fi_direct[rule->result]) ||
                       Fi_rules[i].test_intersect(indirect_first)
                    { // first_sym is a nonterminal shadowing a conflict
                        printf("inlining on ");
                        rule->print(*nonterm_symbs);
                        has_changed = true;
                        rules->remove(i);
                        int j = 0;
                        while j < rules_len {
                            gram_rule_t* rule2 = rules->ith(j);
                            if rule2->result == first_sym.dat.NonTerm_dat.symb {
                                gram_rule_t* newrule = malloc(sizeof(gram_rule_t)) as gram_rule_t*;
                                *newrule = *rule;
                                newrule->pattern = rule->pattern.deepcopy();
                                inline_rule(rule2, newrule);
                                rules->append(newrule);
                            }
                            j = j + 1;
                        }
                        i = INT_MAX-1; // we break off the loop
                    } else {
                        indirect_first.union_with(Fi_rules[i]);
                        indirect_first.remove(epsilon);
                    }
                }
            }
            i = i + 1;
        }
        free(Fi);
        free(Fi_direct);
        indirect_first.del();
        if max_iter <= 0 {
            has_changed = false;
            printf("fix_factoring_conflicts reached max iteration count\n");
        }
        if has_changed {
            fix_factoring_conflicts(rules, nonterm_symbs, max_iter);
        }
    }
}


fun gram_rule_t* make_rule(const char* str, clist_voidptr => void* rule_result_function, string_list* nonterm_symbs) {
    
    char* tmp;
    if str[0] != '$' || str[1] == '$' {
        printf("rule initial symbol must be a nonterminal\n");
        exit(EXIT_FAILURE);
    }

    str = str + 1;

    gram_rule_t ret;
    ret.init(string_list_thingy(nonterm_symbs, copy_string_until_char(&str, ' ')),
        rule_result_function);


    while *str && *str == ' ' { str = str + 1; }
    if str[0] != '-' || str[1] != '>' {          // testing we have a "->" after first symbol
        printf("expected \"->\" after initial symbol of rule\n");
        exit(EXIT_FAILURE);
    }
    str = str + 2;

    while *str {
        while *str && *str == ' ' { str = str + 1; }

        if str[0] == '$' && str[1] == '{' { // escape sequence exact
            str = str + 2;
            tmp = copy_string_until_char(&str, '}');
            ret.add_exact(tmp);
            free(tmp);
            tmp = nullptr;
        } elif str[0] == '$' && str[1] == '[' { // escape sequence terminal
            str = str + 2;
            tmp = copy_string_until_char(&str, ']');
            ret.add_term(tmp);
            free(tmp);
            tmp = nullptr;
        } elif str[0] == '$' { // nonterminal
            str = str + 1;
            ret.add_nonterm(string_list_thingy(nonterm_symbs, copy_string_until_char(&str, ' ')));
        } elif str[0] == '@' { // terminal
            str = str + 1;
            tmp = copy_string_until_char(&str, ' ');
            ret.add_term(tmp);
            free(tmp);
            tmp = nullptr;
        } else { // exact
            tmp = copy_string_until_char(&str, ' ');
            ret.add_exact(tmp);
            free(tmp);
            tmp = nullptr;
        }
    }
    
    gram_rule_t* ptrret = malloc(sizeof(gram_rule_t)) as gram_rule_t*;
    *ptrret = ret;
    return ptrret;
}

