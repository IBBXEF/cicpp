
#include "src/cicpp/lexer.cicpp"

specialize clist<const char*> as string_list

func int string_list_find(string_list l, const char* str) {
    int i;
    i = 0;
    while i < l.len() {
        if !strcmp(l.ith(i), str) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}
// if the string is in the list, the pointer is freed and the index returned. otherwise, it is added to the list and its idex is returned
func int string_list_thingy(string_list* l, char* str) {
    int i;
    i = string_list_find(*l, str);
    if i < 0 {
        (*l).append(str);
        return (l->len()) - 1;
    }
    free(str);
    return i;
}
func char* copy_string_until_char(const char** str, char c) {
    const char* base;
    base = *str;
    while (**str) && ((**str) != c) {
        *str = (*str) + 1;
    }
    int len;
    len = (*str) - base;
    char* ret;
    ret = malloc(len + 1) as char* ;
    ret[len] = '\0';
    int i;
    i = 0;
    while i < len {
        ret[i] = base[i];
        i = i + 1;
    }
    return ret;
}

type gram_rule_t {

    specialize clist<gram_rule_t*> as gram_rules

    type gram_symbol_t {
        Term { token tok; };
        Exact { token tok; };
        NonTerm { int symb; };

        func anyptr match_symb(toklist* l, int max_depth, gram_rules rules) {
            anyptr ret;
            ret.init_null();
            if (max_depth < 0) || (((*l).len()) == 0) {
                return ret;
            }
            if kind == Term {
                if (((*l).ith(0)).kind) != (((dat.Term_dat).tok).kind) {
                    return ret;
                }
                ret.init_view((*l).ith_ref(0));
                *l = (*l).tail();
                return ret;
            } elif kind == Exact {
                if !((*l).ith(0)).eq((dat.Exact_dat).tok) {
                    return ret;
                }
                ret.init_view((*l).ith_ref(0));
                *l = (*l).tail();
                return ret;
            } else { // kind == NonTerm
                int i;
                int chosen_len;
                chosen_len = l->len();
                i = 0;
                toklist base;
                toklist chosen_end;
                base = *l;
                chosen_end = *l;
                while i < (rules.len()) {
                    gram_rule_t rule;
                    rule = *(rules.ith(i));
                    if (((rule).result) == ((dat.NonTerm_dat).symb)) {
                        anyptr tmp;
                        tmp = rule.parse(l, max_depth, rules);
                        if tmp.ptr {
                            int curlen;
                            curlen = l->len();
                            if curlen < chosen_len { // we select for the longest match, i.e. the one leaving the fewest tokens
                                chosen_len = curlen;
                                ret.del();
                                ret = tmp;
                                chosen_end = *l;
                            } else {
                                tmp.del();
                            }
                        }
                        *l = base;
                    }
                    i = i + 1;
                }
                *l = chosen_end;
                return ret;
            }
        }

        func void set_nonterm(int i) {
            kind = NonTerm;
            (dat.NonTerm_dat).symb = i;
        }
        func void set_term(token t) {
            kind = Term;
            (dat.Term_dat).tok = t;
        }
        func void set_exact(token t) {
            kind = Exact;
            (dat.Term_dat).tok = t;
        }        

        func void print(string_list nonterm_symbs) {
            if kind == Term {
                printf("Term (id %d)", ((((dat.Term_dat).tok).kind) as int));
            } elif kind == Exact {
                printf("Exact (id %d)", ((((dat.Term_dat).tok).kind) as int));
            } else {
                printf("$%s",
                    ( nonterm_symbs.ith((dat.NonTerm_dat).symb)) );
            }
        }
    }

    specialize clist<gram_symbol_t> as symlist

    symlist pattern; // a nonempty list of symbols
    int result;

    // user-defined "result function" that will turn the matched pattern into the result.
    clist_anyptr -> anyptr result_function;


    func anyptr parse(toklist* l, int max_depth, gram_rules rules) {
        int i;
        i = 0;
        clist_anyptr vlues;
        vlues.init();
        toklist base;
        base = *l;
        anyptr ret;
        while (i < pattern.len()) {
            gram_symbol_t sym;
            sym = pattern.ith(i);
            anyptr vals;
            vals = sym.match_symb(l, max_depth-1, rules);
            if (!(vals.ptr)) {
                *l = base;
                clist_anyptr_free(vlues);
                ret.init_null();
                return ret;
            }
            vlues.append(vals);
            i = i + 1;
        }
        ret = result_function(vlues);
        vlues.del(); // this is not a memory leak, the function is responsible for the elements of the list
        // printf("applied rule at depth %d, parsing %d symbols\n", max_depth, pattern.len());
        return ret;
    }

    func void init(int rule_result, clist_anyptr -> anyptr rule_result_function) {
        result = rule_result;
        result_function = rule_result_function;
        pattern.init();
    }

    func void add_nonterm(int nt) {
        gram_symbol_t sym;
        sym.set_nonterm(nt);
        pattern.append(sym);
    }

    func void add_term(const char* str) {
        toklist l;
        l = lex_string(str);
        while (l.len()) {
            gram_symbol_t sym;
            sym.set_term(l.pop());
            pattern.append(sym);
        }
    }

    func void add_exact(const char* str) {
        toklist l;
        l = lex_string(str);
        while (l.len()) {
            gram_symbol_t sym;
            sym.set_exact(l.pop());
            pattern.append(sym);
        }
    }

    func void print(string_list nonterm_symbs) {
        printf("rule: $%s -> ", nonterm_symbs.ith(result));
        int i;
        i = 0;
        while i < (pattern.len()) {
            if i {
                printf(" ");
            }
            (pattern.ith(i)).print(nonterm_symbs);
            i = i + 1;
        }
        printf("\n");
    }
}


func gram_rule_t* make_rule(const char* str, clist_anyptr -> anyptr rule_result_function, string_list* nonterm_symbs) {
    
    char* tmp;
    if (str[0] != '$') || (str[1] == '$') {
        printf("rule initial symbol must be a nonterminal\n");
        exit(-1);
    }

    str = str + 1;

    gram_rule_t ret;
    (ret).init(string_list_thingy(nonterm_symbs, copy_string_until_char(&str, ' ')),
        rule_result_function);


    while (*str) && ((*str) == ' ') { str = str + 1; }
    if (str[0] != '-') || (str[1] != '>') {          // testing we have a "->" after first symbol
        printf("expected \"->\" after initial symbol of rule\n");
        exit(-1);
    }
    str = str + 2;

    while *str {
        while (*str) && ((*str) == ' ') { str = str + 1; }

        if str[0] == '$' && str[1] == '{' { // escape sequence exact
            str = str + 2;
            tmp = copy_string_until_char(&str, '}');
            ret.add_exact(tmp);
            free(tmp);
            tmp = nullptr;
        } elif str[0] == '$' && str[1] == '{' { // escape sequence terminal
            str = str + 2;
            tmp = copy_string_until_char(&str, '}');
            ret.add_term(tmp);
            free(tmp);
            tmp = nullptr;
        } elif str[0] == '$' { // nonterminal
            str = str + 1;
            ret.add_nonterm(string_list_thingy(nonterm_symbs, copy_string_until_char(&str, ' ')));
        } elif str[0] == '@' { // terminal
            str = str + 1;
            tmp = copy_string_until_char(&str, ' ');
            ret.add_term(tmp);
            free(tmp);
            tmp = nullptr;
        } else { // exact
            tmp = copy_string_until_char(&str, ' ');
            ret.add_exact(tmp);
            free(tmp);
            tmp = nullptr;
        }
    }
    
    gram_rule_t* ptrret;
    ptrret = (malloc(sizeof(gram_rule_t))) as gram_rule_t*;
    *ptrret = ret;
    return ptrret;
}

