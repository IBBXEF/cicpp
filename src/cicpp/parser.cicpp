
#include "src/cicpp/lexer.cicpp"


type nonterm_symb {
    Rval;
    Rvalop;
    RvalI;
    Lval;

    func const char* to_string() {
        if kind == Rval {
            return "Rval";
        } elif kind == Rvalop {
            return "Rvalop";
        } elif kind == RvalI {
            return "RvalI";
        } elif kind == Lval {
            return "Lval";
        }
        printf("invalid nonterminal symbol\n");
        exit(-1);
    }
}

type gram_rule_t {

    specialize clist<gram_rule_t*> as gram_rules

    type gram_symbol_t {
        Term { token tok; };
        Exact { token tok; };
        NonTerm { nonterm_symb symb; };

        func anyptr match_symb(toklist* l, int max_depth, gram_rules rules) {
            anyptr ret;
            ret.init_null();
            if max_depth < 0 {
                return ret;
            }
            if kind == Term {
                if (((*l).ith(0)).kind) != (((dat.Term_dat).tok).kind) {
                    return ret;
                }
                ret.init_view((*l).ith_ref(0));
                *l = (*l).tail();
                return ret;
            } elif kind == Exact {
                if !((*l).ith(0)).eq((dat.Exact_dat).tok) {
                    return ret;
                }
                ret.init_view((*l).ith_ref(0));
                *l = (*l).tail();
                return ret;
            } else { // kind == NonTerm
                int i;
                int chosen_len;
                chosen_len = l->len();
                i = 0;
                toklist base;
                toklist chosen_end;
                base = *l;
                chosen_end = *l;
                while i < (rules.len()) {
                    gram_rule_t rule;
                    rule = *(rules.ith(i));
                    if ((((rule).result).kind) == (((dat.NonTerm_dat).symb).kind)) {
                        anyptr tmp;
                        tmp = rule.parse(l, max_depth, rules);
                        if tmp.ptr {
                            int curlen;
                            curlen = l->len();
                            if curlen < chosen_len { // we select for the longest match, i.e. the one leaving the fewest tokens
                                chosen_len = curlen;
                                ret.del();
                                ret = tmp;
                                chosen_end = *l;
                            } else {
                                tmp.del();
                            }
                        }
                        *l = base;
                    }
                    i = i + 1;
                }
                *l = chosen_end;
                return ret;
            }
        }
        
        func void set_Term() { // temporary
            kind = Term;
        }
        func void set_NonTerm() { // temporary
            kind = NonTerm;
        }
        func void set_Exact() { // temporary
            kind = Exact;
        }

        func void print() {
            if kind == Term {
                printf("Term (id %d)", ((((dat.Term_dat).tok).kind) as int));
            } elif kind == Exact {
                printf("Exact (id %d)", ((((dat.Term_dat).tok).kind) as int));
            } else {
                printf("NonTerm %s",
                    ((dat.NonTerm_dat).symb).to_string());
            }
        }
    }

    specialize clist<gram_symbol_t> as symlist

    symlist pattern; // a nonempty list of symbols
    nonterm_symb result;

    // user-defined "result function" that will turn the matched pattern into the result.
    clist_anyptr -> anyptr result_function;


    func anyptr parse(toklist* l, int max_depth, gram_rules rules) {
        // printf("parsing at depth %d\n", max_depth);
        int i;
        i = 0;
        clist_anyptr vlues;
        vlues.init();
        toklist base;
        base = *l;
        anyptr ret;
        while (i < pattern.len()) {
            gram_symbol_t sym;
            sym = pattern.ith(i);
            anyptr vals;
            vals = sym.match_symb(l, max_depth-1, rules);
            if (!(vals.ptr)) {
                *l = base;
                clist_anyptr_free(vlues);
                ret.init_null();
                return ret;
            }
            vlues.append(vals);
            i = i + 1;
        }
        ret = result_function(vlues);
        vlues.del(); // this is not a memory leak, the function is responsible for the elements of the list
        return ret;
    }

    func void init(nonterm_symb rule_result, clist_anyptr -> anyptr rule_result_function) {
        result = rule_result;
        result_function = rule_result_function;
        pattern.init();
    }

    func void add_nonterm(nonterm_symb nt) {
        gram_symbol_t sym;
        sym.set_NonTerm();
        ((sym.dat).NonTerm_dat).symb = nt;
        pattern.append(sym);
    }

    func void add_term(const char* str) {
        toklist l;
        l = lex_string(str);
        while (l.len()) {
            gram_symbol_t sym;
            sym.set_Term();
            ((sym.dat).Term_dat).tok = l.pop();
            pattern.append(sym);
        }
    }

    func void add_exact(const char* str) {
        toklist l;
        l = lex_string(str);
        while (l.len()) {
            gram_symbol_t sym;
            sym.set_Exact();
            ((sym.dat).Exact_dat).tok = l.pop();
            pattern.append(sym);
        }
    }

    func void print() {
        printf("rule: %s -> ", result.to_string());
        int i;
        i = 0;
        while i < (pattern.len()) {
            if i {
                printf(" ");
            }
            (pattern.ith(i)).print();
            i = i + 1;
        }
        printf("\n");
    }
}


