
// #include "src/cicpp/clist.cicpp"
#include "src/cicpp/lexer.cicpp"



type nonterm_symb {
    Rval0;
    Rval1;
}

type gram_rule_t {

    type gram_symbol_t {
        Term { token tok; };
        NonTerm { nonterm_symb symb; };
    }

    specialize clist<gram_symbol_t> as symlist

    symlist pattern;
    gram_symbol_t result;

    func void* dummy(clist_voidptr res);

    typeof(dummy) result;

    func void* parse(toklist l) {
        return nullptr;
    }
}

specialize clist<gram_rule_t> as gram_rules



