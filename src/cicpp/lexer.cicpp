
#include_C "stdio.h"
#include_C "string.h"
#include_C "stdlib.h"

#include_C "./utils.cpp"

type binop {
    Add; Mul; Sub; Div; Band; Bor; Land; Lor; Eq; Leq; Lt; Neq; Geq; Gt;
}

type unop {
    Lnot;
    Neg;
}

type token {
    Nothing;

    TVoid;
    TInt;
    TChar;

    If;
    Elif;
    Else;
    Return;
    While;
    Const;
    As;

    Type;
    Func;
    Static;
    Specialize;

    Include;
    Include_C;

    LPAREN;
    RPAREN;
    LSQUAR;
    RSQUAR;
    LBRACK;
    RBRACK;
    
    Binop { binop op; };
    Unop  { unop  op; };

    Comma;
    Semicol;
    Set;
    Colon;
    TwoColon;
    Hashtag;
    Dot;

    VInt {int dat;};
    VString {const char* str;};

    Ident {const char* str;};
}
