
#include_C "stdio.h"
#include_C "string.h"
#include_C "stdlib.h"


type binop {
    Add; Mul; Sub; Div; Band; Bor; Land; Lor; Eq; Leq; Lt; Neq; Geq; Gt; Arrow;
}

type unop {
    Lnot;
    Neg;
    Addr;
}

type token {
    TVoid;
    TInt;
    TChar;

    If;
    Elif;
    Else;
    Return;
    While;
    
    Const;
    Typeof;
    As;

    Type;
    Func;
    Static;
    Specialize;

    Include;
    Include_C;

    LPAREN;
    RPAREN;
    LSQUAR;
    RSQUAR;
    LBRACK;
    RBRACK;
    
    Binop { binop op; };
    Unop  { unop  op; };

    Comma;
    Semicol;
    Set;
    Colon;
    TwoColon;
    Hashtag;
    Dot;

    VInt {int dat;};
    VString {const char* str;};

    Ident {const char* str;};

    EndOfInput;

    func void init_EOI() {
        kind = EndOfInput;
    }


    func bool eq(token b) {
        if (kind) != (b.kind) {
            return false;
        }
        if kind == Binop {
            return (((dat.Binop_dat).op).kind) == ((((b.dat).Binop_dat).op).kind);
        } elif kind == Unop {
            return (((dat.Unop_dat).op).kind) == ((((b.dat).Unop_dat).op).kind);
        } elif kind == VInt {
            return ((dat.VInt_dat).dat) == (((b.dat).VInt_dat).dat);
        } elif kind == VString {
            return (!strcmp((dat.VString_dat).str, ((b.dat).VString_dat).str));
        } elif kind == Ident {
            return (!strcmp((dat.Ident_dat).str, ((b.dat).Ident_dat).str));
        }
        return true;
    }
}

#include "src/cicpp/clist.cicpp"

specialize clist<token> as toklist

func toklist lex_string(const char* str);
