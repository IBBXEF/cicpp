
#include_C "stdio.h"
#include_C "string.h"
#include_C "stdlib.h"


type binop {
    Add; Mul; Sub; Div; Band; Bor; Land; Lor; Eq; Leq; Lt; Neq; Geq; Gt;

    func void fprint(FILE* fptr) {
        if (kind == Eq) {
            fprintf(fptr, "==");
        } elif (kind == Neq) {
            fprintf(fptr, "!=");
        } elif (kind == Lt) {
            fprintf(fptr, "<");
        } elif (kind == Leq) {
            fprintf(fptr, "<=");
        } elif (kind == Land) {
            fprintf(fptr, "&&");
        } elif (kind == Lor) {
            fprintf(fptr, "||");
        } elif (kind == Band) {
            fprintf(fptr, "&");
        } elif (kind == Bor) {
            fprintf(fptr, "|");
        } elif (kind == Gt) {
            fprintf(fptr, ">");
        } elif (kind == Geq) {
            fprintf(fptr, ">=");
        } elif (kind == Div) {
            fprintf(fptr, "/");
        } elif (kind == Mul) {
            fprintf(fptr, "*");
        } elif (kind == Sub) {
            fprintf(fptr, "-");
        } elif (kind == Add) {
            fprintf(fptr, "+");
        }
    }
    func void print() {
        fprint(stdout);
    }
}

type unop {
    Lnot;
    Neg;
    Addr;
    Deref;
    func void fprint(FILE* fptr) {
        if (kind == Lnot) {
            fprintf(fptr, "!");
        } elif (kind == Neg) {
            fprintf(fptr, "-");
        } elif (kind == Addr) {
            fprintf(fptr, "&");
        } elif (kind == Deref) {
            fprintf(fptr, "*");
        }
    }
    func void print() {
        fprint(stdout);
    }
}

type token {
    TVoid;
    TInt;
    TChar;
    TBool;

    If;
    Elif;
    Else;
    Return;
    While;
    Match;
    With;
    
    Const;
    Typeof;
    As;

    Type;
    Func;
    Static;
    Specialize;

    Include;
    Include_C;

    LPAREN;
    RPAREN;
    LSQUAR;
    RSQUAR;
    LBRACK;
    RBRACK;
    
    Binop { binop op; };
    Unop  { unop  op; };

    Comma;
    Semicol;
    Set;
    Colon;
    TwoColon;
    Hashtag;
    Dot;
    Arrow;
    Implies;

    VInt {int i;};
    VString {const char* str;};

    Ident {const char* str;};

    EndOfInput;

    func void init_EOI() {
        kind = EndOfInput;
    }


    func bool eq(token b) {
        if kind != b.kind {
            return false;
        }
        match *this : token with
        | Binop (op)    -> { return op.kind == b.dat.Binop_dat.op.kind; }
        | Unop (op)     -> { return op.kind == b.dat.Unop_dat.op.kind; }
        | VInt (i)      -> { return i == b.dat.VInt_dat.i; }
        | VString (str) -> { return !strcmp(dat.VString_dat.str, b.dat.VString_dat.str); }
        | Ident (str)   -> { return !strcmp(dat.Ident_dat.str, b.dat.Ident_dat.str); }
        | _             -> { return true; }
    }

    func void print() {
        match *this : token with
        | LPAREN       -> { printf("("); }
        | RPAREN       -> { printf(")"); }
        | LSQUAR       -> { printf("["); }
        | RSQUAR       -> { printf("]"); }
        | LBRACK       -> { printf("{"); }
        | RBRACK       -> { printf("}"); }
        | TInt         -> { printf("int"); }
        | TVoid        -> { printf("void"); }
        | TChar        -> { printf("char"); }
        | TBool        -> { printf("bool"); }
        | Const        -> { printf("const"); }
        | Static       -> { printf("static"); }
        | Func         -> { printf("func"); }
        | As           -> { printf("as"); }
        | Specialize   -> { printf("specialize"); }
        | Type         -> { printf("type"); }
        | While        -> { printf("while"); }
        | If           -> { printf("if"); }
        | Else         -> { printf("else"); }
        | Elif         -> { printf("elif"); }
        | Match        -> { printf("match"); }
        | With         -> { printf("match"); }
        | Return       -> { printf("return"); }
        | Hashtag      -> { printf("#"); }
        | Set          -> { printf("="); }
        | Dot          -> { printf("."); }
        | Arrow        -> { printf("->"); }
        | Implies      -> { printf("=>"); }
        | Comma        -> { printf(","); }
        | Semicol      -> { printf(";"); }
        | Ident(str)   -> { printf("%s", str); }
        | VInt(i)      -> { printf("%d", i); }
        | VString(str) -> { printf("\"%s\"", str); }
        | Binop(op)    -> { op.print(); }
        | Unop(op)     -> { op.print(); }
        | Typeof       -> { printf("typeof"); }
        | _            -> { printf("kind:%d", kind as int); }
    }
}

#include "src/cicpp/clist.cicpp"

specialize clist<token> as toklist

func toklist lex_string(const char* str);
