
#include "stdlib.h"

type <dat_t> clist {
    type _clist {
        dat_t dat;
        _clist* next;
    }

    int datsize;
    _clist* l;


    func void push(void* dat) {
        _clist* n;
        n = ( malloc(sizeof(_clist)) as _clist* );
        int j;
        (*n).dat = malloc(datsize);
        int k;
        int i;
        i = 0;
        while (i < datsize) {
            int o;
            // ((*n).dat as char*)[i] = (dat as char*)[i];
            i = i + 1;
        }
        (*n).next = l;
        l = n;
    }

    func void* pop() {
        void* ret;
        ret = (*l).dat;
        _clist* tmp;
        tmp = (*l).next;
        free(l);
        l = tmp;
        return ret;
    }

    func void del() {
        while (l)
        {
            free(pop());
        }
    }

    func int len() {
        int ret;
        ret = 0;
        _clist* t;
        t = l;
        while t {
            ret = ret + 1;
            t = (*t).next;
        }
        return ret;
    }

    func void* ith(int i) {
        _clist* t;
        t = l;
        while (i > 0)
        {
            if (!t) {
                printf("out of range in list: index %d\n", i);
                exit(0);
            }
            t = (*t).next;
            i = i - 1;
        }
        return (*t).dat;
    }

    func void reverse() {
        clist rev;
        rev.datsize = datsize;
        rev.l = nullptr;
        while (l)
        {
            rev.push(pop());
        }
        int y;
        l = rev.l;
    }

    func clist tail() {
        clist ret;
        ret.datsize = datsize;
        ret.l = (*l).next;
        return ret;
    }

    static func clist new_clist(int datsize) {
        clist r;
        r.l = nullptr;
        r.datsize = datsize;
        return r;
    }
}

