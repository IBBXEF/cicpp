
#include_C "stdlib.h"
#include_C "stdio.h"

type <dat_t> clist {
    type _clist {
        dat_t dat;
        _clist* next;
    }

    _clist* l;


    func void push(dat_t dat) {
        _clist* n = malloc(sizeof(_clist)) as _clist*;
        n->dat = dat;
        n->next = l;
        l = n;
    }

    func dat_t pop() {
        dat_t ret = l->dat;
        _clist* tmp = l->next;
        free(l);
        l = tmp;
        return ret;
    }

    func void del() {
        while l { pop(); }
    }

    func int len() {
        int ret = 0;
        _clist* t;
        t = l;
        while t {
            ret = ret + 1;
            t = t->next;
        }
        return ret;
    }

    func dat_t* ith_ref(int ind) {
        _clist* t = l;
        int i = ind;
        while i > 0
        {
            if !t {
                printf("out of range in list: index %d while len is %d\n", ind, len());
                exit(-1);
            }
            t = t->next;
            i = i - 1;
        }
        if !t {
            printf("out of range in list: index %d while len is %d\n", ind, len());
            exit(-1);
        }
        dat_t* ret = &(t->dat);
        return ret;
    }

    func dat_t ith(int i) {
        return *ith_ref(i);
    }

    func void reverse() {
        clist rev;
        rev.init();
        while l {
            rev.push(pop());
        }
        l = rev.l;
    }

    func clist deepcopy() {
        clist ret;
        ret.init();
        int i = 0;
        while i < len() {
            ret.push(ith(len() -i - 1));
            i = i + 1;
        }
        return ret;
    }

    func clist tail() {
        clist ret;
        ret.l = l->next;
        return ret;
    }

    func void append(dat_t dat) {
        if l == nullptr {
            push(dat);
        } else { // temporary
            clist tmp = tail();
            tmp.append(dat);
            l->next = tmp.l;
        }
    }

    func void fuse(clist other) {
        if l == nullptr {
            l = other.l;
        } else {
            clist tmp = tail();
            tmp.fuse(other);
            l->next = tmp.l;
        }
    }
    
    func dat_t remove(int i) {
        if i == 0 {
            return pop();
        } else { // temporary
            clist tmp = tail();
            dat_t ret = tmp.remove(i-1);
            l->next = tmp.l;
            return ret;
        }
    }

    func void init() {
        l = nullptr;
    }
}

specialize clist<void*> as clist_voidptr

specialize clist<const char*> as string_list

#include_C "string.h"

func int string_list_find(string_list l, const char* str) {
    int i = 0;
    while i < l.len() {
        if !strcmp(l.ith(i), str) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

