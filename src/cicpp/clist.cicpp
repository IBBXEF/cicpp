
#include_C "stdlib.h"

type <dat_t> clist {
    type _clist {
        dat_t dat;
        _clist* next;
    }

    _clist* l;


    func void push(dat_t dat) {
        _clist* n;
        n = ( malloc(sizeof(_clist)) as _clist* );
        (*n).dat = dat;
        (*n).next = l;
        l = n;
    }

    func dat_t pop() {
        dat_t ret;
        ret = (*l).dat;
        _clist* tmp;
        tmp = (*l).next;
        free(l);
        l = tmp;
        return ret;
    }

    func void del() {
        while (l) { pop(); }
    }

    func int len() {
        int ret;
        ret = 0;
        _clist* t;
        t = l;
        while t {
            ret = ret + 1;
            t = (*t).next;
        }
        return ret;
    }

    func dat_t ith(int i) {
        _clist* t;
        t = l;
        while (i > 0)
        {
            if (!t) {
                printf("out of range in list: index %d\n", i);
                exit(0);
            }
            t = (*t).next;
            i = i - 1;
        }
        return (*t).dat;
    }

    func void reverse() {
        clist rev;
        (rev).l = nullptr;
        while (l)
        {
            rev.push(pop());
        }
        l = rev.l;
    }

    func clist tail() {
        clist ret;
        (ret).l = (*l).next;
        return ret;
    }

    func void init() {
        l = nullptr;
    }
}

specialize clist<void*> as clist_voidptr

