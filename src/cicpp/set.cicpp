
#include "src/cicpp/clist.cicpp"

type <set_dat_t> set {
    specialize clist<set_dat_t> as datlist
    datlist elts;

    fun void init() {
        elts.init();
    }
    fun void del() {
        elts.del();
    }
    fun bool contains(set_dat_t s) {
        int i = 0;
        while i < elts.len() {
            if s.eq(elts.ith(i)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    fun bool remove(set_dat_t s) {
        int i = 0;
        while i < elts.len() {
            if s.eq(elts.ith(i)) {
                elts.remove(i);
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    fun bool add(set_dat_t s) {
        if !contains(s) {
            elts.push(s);
            return true;
        }
        return false;
    }
    fun bool union_with(set other) {
        bool ret = false;
        int i = 0;
        while i < other.elts.len() {
            ret = add(other.elts.ith(i)) || ret;
            i = i + 1;
        }
        return ret;
    }
    fun bool test_intersect(set other) {
        int i = 0;
        while i < elts.len() {
            if other.contains(elts.ith(i)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
}

type <dat_t> comparable_ptr {
    dat_t* ptr;
    fun void init_null() {
        ptr = nullptr;
    }
    fun void init_ptr(dat_t* p) {
        ptr = p;
    }
    fun bool eq(comparable_ptr p2) {
        if !ptr || !p2.ptr {
            return ptr == p2.ptr;
        }
        return ptr->eq(*p2.ptr);
    }
}
