
#include "src/cicpp/clist.cicpp"

type <set_dat_t> set {
    specialize clist<set_dat_t> as datlist
    datlist elts;

    func void init() {
        elts.init();
    }
    func void del() {
        elts.del();
    }
    func bool contains(set_dat_t s) {
        int i;
        i = 0;
        while i < (elts.len()) {
            if s.eq(elts.ith(i)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    func bool remove(set_dat_t s) {
        int i;
        i = 0;
        while i < (elts.len()) {
            if s.eq(elts.ith(i)) {
                elts.remove(i);
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    func bool add(set_dat_t s) {
        if !contains(s) {
            elts.push(s);
            return true;
        }
        return false;
    }
    func bool union_with(set other) {
        bool ret;
        ret = false;
        int i;
        i = 0;
        while i < ((other.elts).len()) {
            ret = add((other.elts).ith(i)) || ret;
            i = i + 1;
        }
        return ret;
    }
}

type <dat_t> comparable_ptr {
    dat_t* ptr;
    func void init_null() {
        ptr = nullptr;
    }
    func void init_ptr(dat_t* p) {
        ptr = p;
    }
    func bool eq(comparable_ptr p2) {
        if (!ptr) || (!(p2.ptr)) {
            return ptr == (p2.ptr);
        }
        return ptr->eq(*(p2.ptr));
    }
}
