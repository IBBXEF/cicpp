
#include "stdio.h"
#include "string.h"
#include "stdlib.h"

#include "./utils.cpp"

type binop {
    Add; Mul; Sub; Div; Band; Bor; Land; Lor; Eq; Leq; Lt; Neq; Geq; Gt;
}

type unop {
    Lnot;
}

type token {
    Nothing;

    TVoid;
    TInt;
    TChar;

    If;
    Elif;
    Else;
    Return;
    While;
    Const;

    Type;
    Func;

    Include;

    LPAREN;
    RPAREN;
    LSQUAR;
    RSQUAR;
    LBRACK;
    RBRACK;
    
    Binop { binop op; };
    Unop  { unop  op; };

    Comma;
    Semicol;
    Set;
    Colon;
    TwoColon;
    Hashtag;
    Dot;

    VInt {int dat;};
    VString {const char* str;};

    Ident {const char* str;};
}
