
#include "stdio.h"
#include "string.h"
#include "stdlib.h"

#include "./utils.cpp"

type binop {
    Add; Mul; Sub; Div; Band; Bor; Eq; Leq; Lt; Neq; Geq; Gt;
}

type token {
    TVoid;
    TInt;
    TChar;

    If;
    Elif;
    Else;
    Return;
    While;
    Const;

    Type;
    Func;

    Include;

    LPAREN;
    RPAREN;
    LSQUAR;
    RSQUAR;
    LBRACK;
    RBRACK;
    
    BAnd;
    BOr;
    LAnd;
    LOr;
    LNot;
    Star;
    Plus;
    Minus;
    Div;

    Eq;
    Leq;
    Geq;
    Lt;
    Gt;

    Comma;
    Semicol;
    Set;
    Colon;
    TwoColon;
    Hashtag;
    Dot;

    VInt {int dat;};
    VString {const char* str;};

    Ident {const char* str;};
};

